+IMAGE_PLATFORM_FILES = {
+    "libc++.so": (926896, "3b3a556e1a175baa03cd5e82a4a9189182ad1b1824319f15c681a13fdfdc42f0"),
+    "libc.so": (1126832, "f9eacc7c6402ae1cca97e6e080340e12203bcd43cb44b054522239a7eed64fc4"),
