{"info":{"author":null,"author_email":null,"bugtrack_url":null,"classifiers":["Development Status :: 5 - Production/Stable","Programming Language :: Python","Topic :: Software Development :: Build Tools"],"description":".. SPDX-FileCopyrightText: 2021 The meson-python developers\n\n.. SPDX-License-Identifier: MIT\n\nmeson-python\n============\n\n``meson-python`` is a Python build back-end built on top of the Meson__\nbuild system. It enables using Meson for the configuration and build\nsteps of Python packages. Meson is an open source build system meant\nto be both extremely fast, and, even more importantly, as user\nfriendly as possible. ``meson-python`` is best suited for building\nPython packages containing extension modules implemented in languages\nsuch as C, C++, Cython, Fortran, Pythran, or Rust. Consult the\ndocumentation__ for more details.\n\nQuestions regarding the use of ``meson-python`` can be directed to the\ndiscussions__ space on GitHub. Bug reports and feature requests can be\nfiled as GitHub issues__.\n\n__ https://mesonbuild.com/\n__ https://mesonbuild.com/meson-python/\n__ https://github.com/mesonbuild/meson-python/discussions/\n__ https://github.com/mesonbuild/meson-python/issues/\n","description_content_type":"text/x-rst","docs_url":null,"download_url":null,"downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":null,"home_page":null,"keywords":"meson, build, backend, pep517, package","license":null,"license_expression":"MIT","license_files":["LICENSES/MIT.txt"],"maintainer":null,"maintainer_email":"Ralf Gommers <ralf.gommers@gmail.com>, Daniele Nicolodi <daniele@grinta.net>, Henry Schreiner <HenrySchreinerIII@gmail.com>","name":"meson-python","package_url":"https://pypi.org/project/meson-python/","platform":null,"project_url":"https://pypi.org/project/meson-python/","project_urls":{"changelog":"https://mesonbuild.com/meson-python/changelog.html","documentation":"https://mesonbuild.com/meson-python/","homepage":"https://github.com/mesonbuild/meson-python","repository":"https://github.com/mesonbuild/meson-python"},"provides_extra":null,"release_url":"https://pypi.org/project/meson-python/0.21.1/","requires_dist":["meson>=0.64.0; python_version < \"3.12\"","meson>=1.2.3; python_version >= \"3.12\"","packaging>=23.2; sys_platform != \"ios\"","packaging>=24.2; sys_platform == \"ios\"","pyproject-metadata>=0.9.0","tomli>=1.0.0; python_version < \"3.11\""],"requires_python":">=3.9","summary":"The Python build backend for Meson projects","version":"0.21.1","yanked":false,"yanked_reason":null},"last_serial":41709171,"ownership":{"organization":null,"roles":[{"role":"Owner","user":"dnn"},{"role":"Owner","user":"rgommers"}]},"urls":[{"comment_text":null,"core-metadata":{"sha256":"261a90610ce09a70b458df85c4862c3122881a8dd96c462ee62f5f86b6bbeafa"},"digests":{"blake2b_256":"9e4f03aeed5a32e7e8158d8c617fe65b622410db974fe02e3bd78da9689a44fd","md5":"90e0e8188de9808c3df030b0cff3574e","sha256":"270bc9b78957c47e0aa1758ad616dba3f943d8f9cbdb944d318c3c1c7a49e4bd"},"downloads":-1,"filename":"meson_python-0.21.1-py3-none-any.whl","has_sig":false,"md5_digest":"90e0e8188de9808c3df030b0cff3574e","packagetype":"bdist_wheel","python_version":"py3","requires_python":">=3.9","size":29579,"upload_time":"2026-09-11T14:00:58","upload_time_iso_8601":"2026-09-11T14:00:58.133521Z","url":"https://files.pythonhosted.org/packages/9e/4f/03aeed5a32e7e8158d8c617fe65b622410db974fe02e3bd78da9689a44fd/meson_python-0.21.1-py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"edf2ab554fe4f020ec5f0ab4e4af04318e6ab99660f8d8d14e3d064db2b786a6","md5":"535eafa2b13c08be084fbf0ac1772570","sha256":"78b3345dcbc0fed7b939e7e37a9faab35bddaae07bf62e7542c8ad479c395af5"},"downloads":-1,"filename":"meson_python-0.21.1.tar.gz","has_sig":false,"md5_digest":"535eafa2b13c08be084fbf0ac1772570","packagetype":"sdist","python_version":"source","requires_python":">=3.9","size":113878,"upload_time