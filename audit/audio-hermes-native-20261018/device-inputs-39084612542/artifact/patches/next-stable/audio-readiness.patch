diff --git a/tools/voice_mode_capture.py b/tools/voice_mode_capture.py
index 30b63355..04bf5b85 100644
--- a/tools/voice_mode_capture.py
+++ b/tools/voice_mode_capture.py
@@ -8,6 +8,24 @@ from collections.abc import Callable, Mapping
 _BACKENDS = {"auto", "sounddevice", "termux-api"}
 
 
+class AudioInitializationError(RuntimeError):
+    """Optional audio libraries exist but cannot initialize their native runtime."""
+
+
+def import_audio_modules():
+    """Translate import-time native failures without hiding missing dependencies."""
+    try:
+        import sounddevice as sd
+        import numpy as np
+    except (ImportError, OSError):
+        raise
+    except Exception as exc:
+        # sounddevice initializes PortAudio during import; PortAudioError derives
+        # directly from Exception and cannot be imported after that import fails.
+        raise AudioInitializationError(f"Audio library initialization failed: {exc}") from exc
+    return sd, np
+
+
 def choose_backend(config: Mapping[str, object], *, termux_available: Callable[[], bool]) -> str:
     raw = config.get("capture_backend", "auto")
     name = raw.strip().lower() if isinstance(raw, str) else ""
diff --git a/tests/tools/test_voice_audio_readiness.py b/tests/tools/test_voice_audio_readiness.py
new file mode 100644
index 00000000..4233b699
--- /dev/null
+++ b/tests/tools/test_voice_audio_readiness.py
@@ -0,0 +1,87 @@
+"""Audio readiness reports native initialization failures without opening a microphone."""
+
+from __future__ import annotations
+
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from tools import voice_mode as vm
+from tools import voice_mode_capture as capture
+
+
+@pytest.fixture
+def unavailable_portaudio(tmp_path, monkeypatch):
+    """sounddevice 0.5.5 initializes on import and raises Exception, not OSError."""
+    (tmp_path / "sounddevice.py").write_text(
+        'class PortAudioError(Exception):\n'
+        '    def __str__(self):\n'
+        '        return f"{self.args[0]} [PaErrorCode {self.args[1]}]: {self.args[2][2]}"\n'
+        'raise PortAudioError("Error initializing PortAudio", -9999, '
+        '(-10000, -9999, "Initializing engine failed"))\n',
+        encoding="utf-8",
+    )
+    monkeypatch.syspath_prepend(str(tmp_path))
+    monkeypatch.delitem(sys.modules, "sounddevice", raising=False)
+    import pm
+    monkeypatch.setattr(pm, "available", lambda extra: extra == "audio-io")
+
+    def unexpected_install(*args, **kwargs):
+        pytest.fail("an installed library's initialization failure must not provision dependencies")
+
+    monkeypatch.setattr(pm, "ensure_import", unexpected_install)
+
+
+def test_portaudio_import_failure_is_a_readiness_diagnostic(unavailable_portaudio):
+    assert vm._audio_available() is False
+    reason = vm._audio_unavailable_reason()
+    assert "initialization failed" in reason.lower()
+    assert "Initializing engine failed" in reason
+    assert "-9999" in reason
+    assert "not found" not in reason
+
+    result = capture.capture_requirements({"capture_backend": "sounddevice"})
+    assert result["available"] is False
+    assert reason in result["detail"]
+
+    warnings, notices = [], []
+    vm._probe_audio_libraries(
+        warnings, notices, has_forwarded_audio=False,
+        termux_mic_cmd=None, termux_app_installed=False,
+    )
+    assert warnings == [reason]
+    assert notices == []
+
+    recorder = vm.AudioRecorder()
+    with pytest.raises(RuntimeError, match="initialization failed") as caught:
+        recorder.start()
+    assert type(caught.value.__cause__).__name__ == "PortAudioError"
+    assert not recorder.is_recording
+    assert recorder._stream is None
+
+
+@pytest.mark.parametrize(
+    "devices, forwarded, ready",
+    [
+        ([{"name": "speaker", "max_input_channels": 0, "max_output_channels": 2}], False, False),
+        ([{"name": "speaker", "max_input_channels": 0, "max_output_channels": 2}], True, False),
+        ([{"name": "speaker", "max_input_channels": 0, "max_output_channels": 2},
+          {"name": "microphone", "max_input_channels": 1, "max_output_channels": 0}], False, True),
+    ],
+)
+def test_device_inventory_requires_an_input_not_just_output(monkeypatch, devices, forwarded, ready):
+    library = SimpleNamespace(query_devices=lambda: devices)
+    monkeypatch.setattr(vm, "_import_audio", lambda: (library, None))
+    warnings, notices = [], []
+
+    vm._probe_audio_libraries(
+        warnings, notices, has_forwarded_audio=forwarded,
+        termux_mic_cmd=None, termux_app_installed=False,
+    )
+
+    assert (not warnings) is ready
+    assert notices == []
+    if not ready:
+        assert "input" in warnings[0].lower()
+        assert "output" in warnings[0].lower()
