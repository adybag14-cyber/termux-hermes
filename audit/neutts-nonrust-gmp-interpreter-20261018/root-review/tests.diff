+SCIKIT_SOURCE = next(s for s in LOCK["sources"] if s["name"] == "scikit-learn")
+SCIKIT_FIXTURE = BASELINE.parent / "scikit_learn_interpreter"
+SCIKIT_PATCH = ROOT / "patches/next-stable/scikit-learn-selected-python.patch"
