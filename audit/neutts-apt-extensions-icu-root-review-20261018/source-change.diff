+    observed = evidence["observed_unknown_image_member"]
+    require(evidence["run"]["id"] == 39082604000
+            and evidence["run"]["head_sha"] == "2bf6e32b4009ca5233686d80a1dd2dcbf53cb7d2"
+            and evidence["run"]["conclusion"] == "failure"
