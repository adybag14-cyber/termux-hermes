+def _hub_download_parameters(proxies):
+    parameters = inspect.signature(hf_hub_download).parameters
+    if proxies and "proxies" not in parameters:
+        raise ValueError(
+            "This huggingface_hub version does not support per-call proxies. "
+            "Configure HTTP_PROXY and HTTPS_PROXY, or "
+            "huggingface_hub.set_client_factory, before loading the codec."
+        )
+    return parameters
+
+
+def _download_from_hub(*, proxies=None, resume_download=False, **kwargs):
+    """Keep legacy Hub options without passing removed arguments to Hub 1.x."""
+    parameters = _hub_download_parameters(proxies)
+    if "proxies" in parameters:
+        kwargs["proxies"] = proxies
+    if "resume_download" in parameters:
+        kwargs["resume_download"] = resume_download
+    # Hub 1.x resumes downloads automatically when possible.
+    return hf_hub_download(**kwargs)
+
+
+class _HubDownloadCompat:
+    @classmethod
+    def from_pretrained(cls, *args, **kwargs):
+        # Hub's public method may fetch config before our _from_pretrained hook.
+        _hub_download_parameters(kwargs.get("proxies"))
+        return super().from_pretrained(*args, **kwargs)
+
