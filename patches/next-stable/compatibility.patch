@@ -0,0 +1,207 @@
+"""Owned runit lifecycle and sealed-launcher contracts; native execution has an ARM probe."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+import subprocess
+
+import pytest
+
+from hermes_cli import gateway, gateway_runit as runit
+from hermes_platform.resolver.termux_services import TermuxServices, resolve_termux_services
+
+
+class Supervisor:
+    """The sv protocol as a deterministic process fixture, independent of host OS."""
+
+    def __init__(self, tools):
+        self.tools, self.records, self.calls = tools, {}, []
+        self.next_pid = 100
+
+    def _key(self, path):
+        return json.loads((path / runit.MARKER).read_text())["home"]
+
+    def __call__(self, args, **kwargs):
+        self.calls.append(list(args))
+        assert "LD_LIBRARY_PATH" not in kwargs["env"]
+        if Path(args[0]) == self.tools.daemon:
+            for path in self.tools.services.glob("hermes-gateway-*"):
+                key = self._key(path)
+                self.records.setdefault(key, None if (path / "down").exists() else self._pid())
+            return subprocess.CompletedProcess(args, 0, "", "")
+        verb = args[-2]
+        path = Path(args[-1])
+        key = self._key(path)
+        if key not in self.records:
+            return subprocess.CompletedProcess(args, 1, "", "supervisor unavailable")
+        if verb == "status":
+            pid = self.records[key]
+            text = f"run: {path}: (pid {pid}) 2s" if pid else f"down: {path}: 2s"
+            return subprocess.CompletedProcess(args, 0, text, "")
+        if verb in ("start", "restart"):
+            self.records[key] = self._pid()
+        elif verb == "stop":
+            self.records[key] = None
+        elif verb == "shutdown":
+            del self.records[key]
+        else:
+            raise AssertionError(verb)
+        return subprocess.CompletedProcess(args, 0, "", "")
+
+    def _pid(self):
+        self.next_pid += 1
+        return self.next_pid
+
+
+@pytest.fixture
+def service(tmp_path, monkeypatch):
+    tools = TermuxServices(tmp_path / "prefix")
+    home, root = tmp_path / "home with 'quotes'", tmp_path / "app"
+    home.mkdir()
+    root.mkdir()
+    service = runit.RunitService(tools, home, root)
+    supervisor = Supervisor(tools)
+    monkeypatch.setattr(runit.subprocess, "run", supervisor)
+    return service, supervisor
+
+
+@pytest.mark.parametrize("start_now", [True, False])
+@pytest.mark.parametrize("start_on_login", [True, False])
+def test_install_separates_current_run_from_next_login(service, start_now, start_on_login):
+    svc, supervisor = service
+    svc.install(["/stable/launcher", "gateway", "run"],
+                start_now=start_now, start_on_login=start_on_login)
+    assert svc.state().running is start_now
+    assert (svc.path / "down").exists() is (not start_on_login)
+    assert json.loads((svc.path / runit.MARKER).read_text()) == svc.identity
+    # A plain start/stop does not rewrite the user's next-login policy.
+    svc.stop()
+    assert not svc.state().running
+    svc.start()
+    assert svc.state().running
+    assert (svc.path / "down").exists() is (not start_on_login)
+    assert all(args[1:] == ["start"] for args in supervisor.calls
+               if Path(args[0]) == svc.tools.daemon)
+
+
+def test_stop_restart_uninstall_only_control_the_owning_home(service):
+    first, supervisor = service
+    second_home = first.home.parent / "another root" / first.home.name
+    second_home.mkdir(parents=True)
+    second = runit.RunitService(first.tools, second_home, first.root)
+    first.install(["/stable/first"])
+    second.install(["/stable/second"])
+    assert first.path.name != second.path.name
+    first_pid, second_pid = first.state().pid, second.state().pid
+    first.restart()
+    assert first.state().pid != first_pid
+    assert second.state().pid == second_pid
+    first.stop()
+    assert not first.state().running and second.state().pid == second_pid
+    first.uninstall()
+    assert not first.path.exists() and second.state().pid == second_pid
+    assert all(args[1:] == ["start"] for args in supervisor.calls
+               if Path(args[0]) == first.tools.daemon)
+
+
+def test_force_cannot_overwrite_a_foreign_installation(service):
+    svc, supervisor = service
+    svc.install(["/stable/launcher"])
+    foreign = {**svc.identity, "root": str(svc.root.parent / "foreign")}
+    (svc.path / runit.MARKER).write_text(json.dumps(foreign))
+    calls = list(supervisor.calls)
+    with pytest.raises(runit.RunitServiceError, match="Refusing foreign"):
+        svc.install(["/unrelated"], force=True)
+    with pytest.raises(runit.RunitServiceError, match="Refusing foreign"):
+        svc.uninstall()
+    assert supervisor.calls == calls
+    assert json.loads((svc.path / runit.MARKER).read_text()) == foreign
+
+
+def test_unowned_directory_is_preserved(service):
+    svc, supervisor = service
+    svc.path.mkdir(parents=True)
+    sentinel = svc.path / "user-data.txt"
+    sentinel.write_text("belongs to someone else")
+    with pytest.raises(runit.RunitServiceError, match="Refusing foreign"):
+        svc.install(["/stable/launcher"], force=True)
+    assert sentinel.read_text() == "belongs to someone else"
+    assert not supervisor.calls
+
+
+def test_failed_control_never_claims_success(service, monkeypatch):
+    svc, supervisor = service
+    svc.install(["/stable/launcher"])
+    original = supervisor.__call__
+
+    def refuse_stop(args, **kwargs):
+        if args[-2] == "stop":
+            return subprocess.CompletedProcess(args, 1, "timeout: service still running", "")
+        return original(args, **kwargs)
+
+    monkeypatch.setattr(runit.subprocess, "run", refuse_stop)
+    with pytest.raises(runit.RunitServiceError, match="still running"):
+        svc.stop()
+    assert svc.state().running
+
+
+def test_missing_service_does_not_start_shared_daemon(service):
+    svc, supervisor = service
+    with pytest.raises(runit.RunitServiceError, match="not installed"):
+        svc.start()
+    assert not supervisor.calls
+
+
+def test_user_scope_refuses_system_identity():
+    for kwargs in ({"system": True}, {"run_as_user": "root"}):
+        with pytest.raises(runit.RunitServiceError, match="Termux app user"):
+            runit.require_user_scope(**kwargs)
+    runit.require_user_scope()
+
+
+def test_sealed_service_uses_manifest_launcher_without_mutating_source(tmp_path, monkeypatch):
+    root = tmp_path / "app"
+    root.mkdir()
+    command = tmp_path / "bin" / "hermes"
+    command.parent.mkdir()
+    command.write_text("sealed launcher fixture")
+    (tmp_path / "manifest.json").write_text(json.dumps({
+        "repo": "app", "venv": "venv", "store": "tools",
+        "runtime": {"commands": {"hermes": "bin/hermes"}},
+    }))
+    monkeypatch.setattr(gateway, "PROJECT_ROOT", root)
+
+    def must_not_mint(**kwargs):
+        raise AssertionError("a sealed payload must retain its own launcher")
+
+    monkeypatch.setattr(gateway, "_prepare_service_launcher", must_not_mint)
+    assert runit.command_for_service() == [
+        str(command), "gateway", "run", "--external-supervisor",
+    ]
+
+
+def test_sealed_install_without_manifest_launcher_fails_closed(tmp_path, monkeypatch):
+    monkeypatch.setattr(gateway, "PROJECT_ROOT", tmp_path)
+    monkeypatch.setattr(gateway, "_is_apt_termux_install", lambda: True)
+    with pytest.raises(runit.RunitServiceError, match="reinstall"):
+        runit.command_for_service()
+
+
+def test_native_tool_environment_does_not_capture_cli_runtime(tmp_path, monkeypatch):
+    for key in ("LD_LIBRARY_PATH", "HERMES_RUNTIME_DIR", "HERMES_HOME",
+                "PYTHONPATH", "PYTHONHOME", "OPENAI_API_KEY"):
+        monkeypatch.setenv(key, "must not inherit")
+    tools = TermuxServices(tmp_path / "prefix")
+    env = tools.environment()
+    assert env["PREFIX"] == str(tools.prefix)
+    assert env["SVDIR"] == str(tools.services)
+    assert not any(value == "must not inherit" for value in env.values())
+    assert resolve_termux_services(tmp_path / "missing") is None
+
+
+def test_runit_failure_uses_its_own_actionable_guidance():
+    from hermes_cli.gateway_command_errors import explain_service_failure
+    lines = explain_service_failure(runit.RunitServiceError("owned service could not stop"))
+    assert lines[0] == "owned service could not stop"
+    assert "gateway-runit.log" in lines[1]
+    assert all("systemd" not in line for line in lines)
