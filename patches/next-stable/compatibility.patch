diff --git a/scripts/termux/compat_sources.py b/scripts/termux/compat_sources.py
new file mode 100644
index 00000000..18251d53
--- /dev/null
+++ b/scripts/termux/compat_sources.py
@@ -0,0 +1,108 @@
+"""Small, reviewed source-build adaptations for the Android wheel builder.
+
+Only the two locked releases below are changed. Downloading the archive before
+running its backend avoids an unpatched metadata hook invoking the wrong shell
+or an incompatible CMake policy. The only non-build-hook edit is Termux's
+reviewed libolm const-pointer correction for modern Clang.
+"""
+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
+from typing import Callable
+from urllib.parse import urlsplit
+from urllib.request import urlopen
+
+SOURCES = {
+    "uvloop": (
+        "6c84bae345b9147082b17371e3dd5d42775bddce91f885499017f4607fdaf39f",
+        2443250,
+    ),
+    "python-olm": (
+        "a1c47fce2505b7a16841e17694cbed4ed484519646ede96ee9e89545a49643c9",
+        2705522,
+    ),
+}
+
+
+def _replace_once(text: str, old: str, new: str) -> str:
+    if text.count(old) != 1:
+        raise ValueError("Reviewed source-build hook changed; refusing a partial patch")
+    return text.replace(old, new, 1)
+
+
+def patch_uvloop_source(source: Path, shell: Path) -> None:
+    """Run libuv's scripts through Termux sh, including setup.py's configure."""
+    path = source / "setup.py"
+    text = path.read_text(encoding="utf-8")
+    text = _replace_once(
+        text, "['/bin/sh', 'autogen.sh']",
+        "[env['CONFIG_SHELL'], 'autogen.sh']",
+    )
+    text = _replace_once(
+        text, "cmd = ['./configure', '--host=' + env['LIBUV_CONFIGURE_HOST']]",
+        "cmd = [env['CONFIG_SHELL'], './configure', '--host=' + env['LIBUV_CONFIGURE_HOST']]",
+    )
+    text = _replace_once(
+        text, "cmd = ['./configure']",
+        "cmd = [env['CONFIG_SHELL'], './configure']",
+    )
+    # CONFIG_SHELL is also inherited by configure's recursive shell invocations.
+    if not shell.is_absolute() or not shell.is_file():
+        raise ValueError(f"Termux configure shell is unavailable: {shell}")
+    path.write_text(text, encoding="utf-8")
+
+
+def patch_python_olm_source(source: Path) -> None:
+    """Apply Termux's CMake policy and modern-Clang const-pointer correction."""
+    path = source / "olm_build.py"
+    text = path.read_text(encoding="utf-8")
+    text = _replace_once(
+        text,
+        '["cmake", ".", "-Bbuild", "-DBUILD_SHARED_LIBS=NO"]',
+        '["cmake", ".", "-Bbuild", "-DBUILD_SHARED_LIBS=NO", '
+        '"-DCMAKE_POLICY_VERSION_MINIMUM=3.5", "-DOLM_TESTS=OFF"]',
+    )
+    header = source / "libolm/include/olm/list.hh"
+    list_text = _replace_once(
+        header.read_text(encoding="utf-8"),
+        "T * const other_pos = other._data;",
+        "T const * other_pos = other._data;",
+    )
+    path.write_text(text, encoding="utf-8")
+    header.write_text(list_text, encoding="utf-8")
+
+
+def prepare_compat_source(
+    name: str, requirement: str, workdir: Path, *,
+    extract: Callable[[Path, Path], Path],
+) -> tuple[Path, dict[str, str]]:
+    """Validate, extract and adapt one supported locked source release."""
+    digest, size = SOURCES[name]
+    prefix = f"{name} @ "
+    if not requirement.startswith(prefix):
+        raise ValueError(f"Expected a locked direct source requirement for {name}")
+    parsed = urlsplit(requirement[len(prefix):])
+    if (
+        parsed.scheme != "https"
+        or parsed.netloc != "files.pythonhosted.org"
+        or parsed.query
+        or parsed.fragment != f"sha256={digest}"
+        or not parsed.path.endswith(".tar.gz")
+    ):
+        raise ValueError(f"Unreviewed {name} source archive")
+    archive = workdir / f"{name}.tar.gz"
+    url = parsed._replace(fragment="").geturl()
+    with urlopen(url, timeout=120) as response:
+        data = response.read(size + 1)
+    if len(data) != size or hashlib.sha256(data).hexdigest() != digest:
+        raise ValueError(f"{name} source archive size or SHA-256 mismatch")
+    archive.write_bytes(data)
+    source = extract(archive, workdir / "source")
+    if name == "uvloop":
+        shell = Path(os.environ["PREFIX"]) / "bin/sh"
+        patch_uvloop_source(source, shell)
+        return source, {"CONFIG_SHELL": str(shell)}
+    patch_python_olm_source(source)
+    return source, {}
