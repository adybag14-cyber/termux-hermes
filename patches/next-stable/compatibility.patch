--- /dev/null
+++ b/pm/agent_browser.py
@@ -0,0 +1,27 @@
+"""Architecture and linkage evidence for the pinned Termux browser driver."""
+from __future__ import annotations
+
+from pathlib import Path
+import struct
+
+
+def static_arm64_reason(binary: Path | None) -> str:
+    """The Android route requires the archive's static ARM64 executable."""
+    if binary is None:
+        return "Termux agent-browser has no selected binary"
+    try:
+        raw = binary.read_bytes()
+        if len(raw) < 64 or raw[:6] != b"\x7fELF\x02\x01":
+            return "Termux agent-browser requires a little-endian ELF64 binary"
+        if struct.unpack_from("<H", raw, 18)[0] != 183:
+            return "Termux agent-browser requires an ARM64 binary"
+        offset = struct.unpack_from("<Q", raw, 32)[0]
+        size, count = struct.unpack_from("<HH", raw, 54)
+        if not count or size < 56 or offset < 64 or offset + size * count > len(raw):
+            return "Termux agent-browser has invalid ELF program headers"
+        headers = [struct.unpack_from("<I", raw, offset + i * size)[0] for i in range(count)]
+        if 2 in headers or 3 in headers:
+            return "Termux agent-browser must be static, with no ELF interpreter or dynamic dependencies"
+    except (OSError, struct.error) as exc:
+        return f"Cannot inspect Termux agent-browser linkage: {exc}"
+    return ""
