+"""Termux desktop behavior: user-owned installs, X11 paths, and isolated native capture."""
+
+from __future__ import annotations
+
+import os
+import shlex
+from pathlib import Path
+
+import pytest
+
+from hermes_platform.resolver import Candidate, Resolution
+from tools.bot_desktop import runtime, termux
+from tools.bot_desktop.runtime import missing_binaries
+
+
+def found_command(path):
+    return Resolution("explicit_path", (Candidate(path, "explicit", True),))
+
+
+def test_android_host_support_requires_the_termux_x11_environment():
+    assert runtime.is_supported_host(platform="android", termux=True)
+    assert not runtime.is_supported_host(platform="android", termux=False)
+    assert runtime.is_supported_host(platform="linux", termux=False)
+    assert not runtime.is_supported_host(platform="win32", termux=False)
+
+
+def test_termux_apt_never_requires_root_or_sudo(monkeypatch):
+    monkeypatch.setattr(runtime, "package_manager", lambda: "termux")
+    monkeypatch.setattr(runtime, "is_root", lambda: pytest.fail("Termux APT belongs to its app user"))
+    assert runtime.installable()
+    argv = shlex.split(runtime.install_command())
+    assert argv[:2] == ["bash", "-c"]
+    assert "sudo" not in argv[2]
+    assert argv[2].index("x11-repo") < argv[2].index(" update") < argv[2].index("tigervnc")
+    assert "--no-remove" in argv[2]
+
+
+def test_termux_manager_requires_its_actual_apt_command(monkeypatch):
+    seen = []
+    monkeypatch.setattr(termux, "locate_command", lambda command: seen.append(command) or found_command("/prefix/bin/apt-get"))
+    assert runtime.package_manager(termux=True) == "termux"
+    assert seen == ["apt-get"]
+    monkeypatch.setattr(termux, "locate_command", lambda command: Resolution("missing"))
+    assert runtime.package_manager(termux=True) is None
+
+
+def test_termux_native_children_keep_profile_state_and_use_system_libraries(tmp_path):
+    base = {"LD_LIBRARY_PATH": "/bundle/runtime-libs", "XAUTHORITY": "/profile-a/auth", "DISPLAY": ":25"}
+    env = termux.launcher_env(base, termux=True, system_prefix=tmp_path)
+    assert "LD_LIBRARY_PATH" not in env
+    assert env["DISPLAY"] == ":25" and env["XAUTHORITY"] == "/profile-a/auth"
+    assert env["HERMES_BD_XLOCK_DIR"] == str(tmp_path / "tmp")
+    assert env["HERMES_BD_SYSTEM_SHARE"] == str(tmp_path / "share")
+    assert base["LD_LIBRARY_PATH"] == "/bundle/runtime-libs"
+    assert termux.launcher_env(base, termux=False) == base
+
+
+def test_termux_x11_socket_detection_uses_the_compiled_prefix(tmp_path, monkeypatch):
+    xdir = tmp_path / "usr"
+    sockets = termux.x_lock_dir(termux=True, system_prefix=xdir) / ".X11-unix"
+    table = tmp_path / "unix"
+    table.write_text(
+        "Header\n"
+        f"0000: 0002 0000 00010000 0001 01 123 @{(sockets / 'X20').as_posix()}\n"
+        f"0000: 0002 0000 00010000 0001 01 124 {(sockets / 'X200').as_posix()}\n",
+        encoding="utf-8",
+    )
+    monkeypatch.setattr(runtime, "_X_SOCKET_DIR", sockets)
+    monkeypatch.setattr(runtime, "_X_UNIX_TABLE", table)
+    assert runtime._x_socket_bound(20)
+    assert not runtime._x_socket_bound(2)
+    assert not runtime._x_socket_bound(21)
+
+
+def test_scrot_grabs_only_the_requested_profile_and_cleans_its_temporary_file(tmp_path, monkeypatch):
+    from PIL import Image
+    from tools.environments import local
+    parent_auth = os.environ.get("XAUTHORITY")
+    seen = []
+    monkeypatch.setattr(termux, "locate_command", lambda name: found_command("/prefix/bin/scrot"))
+    monkeypatch.setattr(local, "served_profile_child_env",
+                        lambda **kw: {"LD_LIBRARY_PATH": "/bundle", "DISPLAY": ":wrong"})
+    def run(argv, **kw):
+        assert argv[:3] == ["/prefix/bin/scrot", "--silent", "--overwrite"]
+        assert kw["env"]["DISPLAY"] == ":28"
+        assert kw["env"]["XAUTHORITY"] == "/profile-b/auth"
+        assert "LD_LIBRARY_PATH" not in kw["env"]
+        assert kw["timeout"] == 10 and kw["check"]
+        target = Path(argv[-1])
+        seen.append(target)
+        Image.new("RGB", (3, 2), "red").save(target)
+    monkeypatch.setattr(termux.subprocess, "run", run)
+    image = termux.grab_x11_image({"DISPLAY": ":28", "XAUTHORITY": "/profile-b/auth"})
+    assert image.size == (3, 2) and image.getpixel((0, 0)) == (255, 0, 0)
+    assert seen and not seen[0].exists()
+    assert os.environ.get("XAUTHORITY") == parent_auth
+
+
+def test_missing_scrot_reports_the_supported_install_path(monkeypatch):
+    monkeypatch.setattr(termux, "locate_command", lambda name: Resolution("missing"))
+    with pytest.raises(RuntimeError, match="hermes screen install"):
+        termux.grab_x11_image({"DISPLAY": ":28"})
+
+
+def test_missing_binaries_uses_resolution_presence_not_object_truthiness(monkeypatch):
+    monkeypatch.setattr(termux, "locate_command", lambda name: (
+        Resolution("missing") if name in {"Xvnc", "scrot"} else found_command("/prefix/bin/" + name)
+    ))
+    assert missing_binaries(termux=True) == ["Xvnc", "scrot"]
