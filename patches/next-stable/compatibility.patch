+"""A remote Linux screen remains available from an Android client without a local CUA binary."""
+
+import pytest
+
+from plugins.computer_use.cua import _available_for_placement
+from tools.bot_desktop import placement
+
+
+@pytest.mark.parametrize("platform", ["android", "linux", "win32", "darwin"])
+def test_remote_desktop_does_not_probe_the_client_driver(platform):
+    def local_probe():
+        pytest.fail("the remote screen must not acquire or probe a client-side driver")
+    assert _available_for_placement(platform, placement.TERMINAL, local_probe)
+
+
+@pytest.mark.parametrize("where", [placement.GATEWAY, placement.REFUSED])
+def test_android_does_not_advertise_a_native_phone_driver(where):
+    assert not _available_for_placement("android", where, lambda: True)
+
+
+def test_local_desktop_still_requires_its_own_driver():
+    assert _available_for_placement("linux", placement.GATEWAY, lambda: True)
+    assert not _available_for_placement("linux", placement.GATEWAY, lambda: False)
