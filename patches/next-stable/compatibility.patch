+    const run = vi.fn().mockResolvedValue({ stdout: text })
+
+    await expect(readClipboardText('android', run, env)).resolves.toBe(text)
+    expect(run).toHaveBeenCalledWith(
+      'termux-clipboard-get',
+      [],
+      expect.objectContaining({ encoding: 'utf8', timeout: 10_000 })
+    )
+  })
+
+  it('falls back when the API command or Android permission is unavailable', async () => {
+    const run = vi
+      .fn()
+      .mockRejectedValueOnce(new Error('Termux:API unavailable'))
+      .mockResolvedValueOnce({ stdout: 'X11 fallback' })
+
+    await expect(readClipboardText('android', run, env)).resolves.toBe('X11 fallback')
+    expect(run.mock.calls.map(call => call[0])).toEqual(['termux-clipboard-get', 'xclip'])
+  })
+
+  it('writes UTF-8 stdin through the native API with a bounded wait', async () => {
+    const text = 'hello 日本語 🎤\n'
+    const child = {
+      once: vi.fn((event: string, callback: (code?: number) => void) => {
+        if (event === 'close') callback(0)
+        return child
+      }),
+      unref: vi.fn(),
+      stdin: { end: vi.fn(), once: vi.fn() }
+    }
+    const start = vi.fn().mockReturnValue(child)
+
+    await expect(writeClipboardText(text, 'android', start as any, env)).resolves.toBe(true)
+    expect(start).toHaveBeenCalledWith(
+      'termux-clipboard-set',
+      [],
+      expect.objectContaining({ stdio: ['pipe', 'ignore', 'ignore'], timeout: 10_000 })
+    )
+    expect(child.stdin.end).toHaveBeenCalledWith(text)
+  })
+
+  it('uses an X11 fallback when Android clipboard writing fails', async () => {
+    let calls = 0
+    const child = {
+      once: vi.fn((event: string, callback: (code?: number) => void) => {
+        if (event === 'close') callback(++calls === 1 ? 1 : 0)
+        return child
+      }),
+      unref: vi.fn(),
+      stdin: { end: vi.fn(), once: vi.fn() }
+    }
+    const start = vi.fn().mockReturnValue(child)
+
+    await expect(writeClipboardText('text', 'android', start as any, env)).resolves.toBe(true)
+    expect(start.mock.calls.map(call => call[0])).toEqual(['termux-clipboard-set', 'xclip'])
+  })
+})
+
+describe('clipboard stdin failure', () => {
+  it('falls back without an unhandled EPIPE when the native writer closes early', async () => {
+    let attempt = 0
+    const start = vi.fn(() => {
+      const fail = ++attempt === 1
+      const stream = new EventEmitter()
+      const child = new EventEmitter() as any
+      child.unref = vi.fn()
+      child.stdin = stream
+      child.stdin.end = () =>
+        queueMicrotask(() => {
+          if (fail) stream.emit('error', new Error('EPIPE'))
+          child.emit('close', fail ? 1 : 0)
+        })
+      return child
+    })
+    await expect(
+      writeClipboardText('text', 'android', start as any, {
+        PREFIX: '/data/data/com.termux/files/usr'
+      })
+    ).resolves.toBe(true)
+    expect(start.mock.calls).toHaveLength(2)
+  })
+})
