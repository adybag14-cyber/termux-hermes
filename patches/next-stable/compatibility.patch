+"""A native selection receipt cannot outlive the inputs or a failed rebuild."""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from scripts.termux.feature_profile import BUNDLED_EXTRAS
+from scripts.termux.selection_receipt import read_selection
+
+
+@pytest.mark.parametrize("changed", ["app/uv.lock", "app/pm/lock.json", "requirements.txt"])
+def test_native_selection_rejects_changed_bundle_inputs(tmp_path, changed):
+    paths = {
+        "uv_lock_sha256": tmp_path / "app/uv.lock",
+        "pm_lock_sha256": tmp_path / "app/pm/lock.json",
+        "requirements_sha256": tmp_path / "requirements.txt",
+    }
+    for path in paths.values():
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(b"reviewed native build input\n")
+    data = {
+        "schema": 1, "target": "linux-arm64-bionic", "extras": list(BUNDLED_EXTRAS),
+        "stamp": "a" * 64,
+        "bundled_wheels": {"path": "bundled-wheels.json", "sha256": "b" * 64},
+        **{key: hashlib.sha256(path.read_bytes()).hexdigest() for key, path in paths.items()},
+    }
+    receipt = tmp_path / "selection.json"
+    receipt.write_text(json.dumps(data), encoding="utf-8")
+    assert read_selection(tmp_path, receipt, paths["requirements_sha256"]) == data
+    (tmp_path / changed).write_bytes(b"different input\n")
+    with pytest.raises(ValueError, match="no longer matches"):
+        read_selection(tmp_path, receipt, paths["requirements_sha256"])
+
+
+def test_failed_native_install_removes_previous_selection_receipt(tmp_path, monkeypatch):
+    from scripts.termux.build_environment import application
+
+    receipt = tmp_path / "venv-selection.json"
+    receipt.parent.mkdir(exist_ok=True)
+    receipt.write_text('{"stamp": "stale"}', encoding="utf-8")
+    requirements = tmp_path / "requirements.txt"
+    requirements.write_text("missing-native==1.0\n", encoding="utf-8")
+
+    def fail(*args, **kwargs):
+        raise RuntimeError("offline native wheel missing")
+
+    monkeypatch.setattr("pm.build_requirements_environment", fail)
+    with pytest.raises(RuntimeError, match="offline native wheel missing"):
+        application(tmp_path, requirements, Path("unused-python"), record_selection=True)
+    assert not receipt.exists()
