+"""The Termux browser driver keeps PM ownership without a nonexistent Chromium artifact."""
+from pathlib import Path
+import struct
+
+import pytest
+
+from pm.agent_browser import static_arm64_reason
+from pm.lock import Lockfile
+from pm import paths
+from pm.packages import AgentBrowser, Chromium
+from pm.registry import walk
+
+
+@pytest.mark.parametrize("target", ["linux-arm64", "linux-x64", "darwin-arm64", "win32-x64", "win32-arm64"])
+def test_other_targets_keep_their_pinned_chromium_dependency(target):
+    assert [p.name for p in walk(["agent-browser"], target=target)] == ["chromium", "agent-browser"]
+
+
+def test_termux_uses_the_existing_pinned_archive_and_external_chromium():
+    target = "linux-arm64-bionic"
+    assert [p.name for p in walk(["agent-browser"], target=target)] == ["agent-browser"]
+    assert AgentBrowser().missing_reason(target) is None
+    assert Chromium().missing_reason(target)
+    lock = Lockfile(paths.lockfile_path())
+    assert lock.artifacts("agent-browser", target) == lock.artifacts("agent-browser", "linux-arm64")
+    assert lock.artifacts("agent-browser", target)
+
+
+def elf(*, program_type=1, machine=183):
+    result = bytearray(120)
+    result[:6] = b"\x7fELF\x02\x01"
+    struct.pack_into("<H", result, 18, machine)
+    struct.pack_into("<Q", result, 32, 64)
+    struct.pack_into("<HH", result, 54, 56, 1)
+    struct.pack_into("<I", result, 64, program_type)
+    return bytes(result)
+
+
+def test_termux_stage_keeps_only_the_executable_that_passed_native_proof(tmp_path):
+    staged = tmp_path / "stage"
+    binaries = staged / "package/bin"
+    binaries.mkdir(parents=True)
+    selected = binaries / "agent-browser-linux-musl-arm64"
+    selected.write_bytes(elf())
+    (binaries / "agent-browser-linux-arm64").write_bytes(b"glibc")
+    package = AgentBrowser()
+    package.stage(None, staged, "0.26.0", "linux-arm64-bionic")
+    binary = package.binary(staged, "linux-arm64-bionic")
+    assert binary == staged / "bin/agent-browser-linux-musl-arm64"
+    assert binary.read_bytes() == elf()
+    assert not (binary.parent / "agent-browser-linux-arm64").exists()
+    assert package.verify(staged, "linux-arm64-bionic") == ""
+
+
+@pytest.mark.parametrize("program_type", [2, 3])
+def test_dynamic_or_interpreted_driver_is_refused(tmp_path, program_type):
+    binary = tmp_path / "driver"
+    binary.write_bytes(elf(program_type=program_type))
+    assert "must be static" in static_arm64_reason(binary)
+
+
+@pytest.mark.parametrize("payload", [b"not ELF", elf(machine=62), elf()[:100]])
+def test_invalid_or_wrong_architecture_driver_is_refused(tmp_path, payload):
+    binary = tmp_path / "driver"
+    binary.write_bytes(payload)
+    assert static_arm64_reason(binary)
