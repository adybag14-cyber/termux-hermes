+def test_bootstrap_sync_runs_without_the_pm_dependencies_it_is_building(catalog_fixture, tmp_path):
+    case = catalog_fixture()
+    source = tmp_path / "empty-bootstrap-project"
+    source.mkdir()
+    (source / "pyproject.toml").write_text(
+        '[project]\nname="bootstrap-fixture"\nversion="1.0"\n'
+        'requires-python=">=3.11"\ndependencies=[]\n[tool.uv]\npackage=false\n', encoding="utf-8",
+    )
+    repo = Path(__file__).resolve().parents[2]
+    # -I -S is an actual interpreter without site-packages, not a fake OS or
+    # import mock. The payload still has a catalog that requires PM's parsers.
+    script = f"""
+import importlib.util, sys
+from pathlib import Path
+sys.path.insert(0, {str(repo)!r})
+assert importlib.util.find_spec("packaging") is None
+import pm.paths
+pm.paths.repo_root = lambda: Path({str(case.root)!r})
+from pm.environment import PythonEnvironment
+environment = PythonEnvironment(
+    uv=Path({shutil.which("uv")!r}), python=Path(sys.executable),
+    destination=Path({str(tmp_path / "bootstrap-venv")!r}),
+    cache=Path({str(tmp_path / "bootstrap-cache")!r}),
+    env=dict(__import__("os").environ), offline=True, use_bundled_wheels=False,
+)
+source = Path({str(source)!r})
+environment.lock(source)
+environment.create()
+environment.sync(source)
+environment.check()
+print("bootstrap complete")
+"""
+    assert _run([sys.executable, "-I", "-S", "-c", script],
+                cwd=source, env=dict(os.environ)) == "bootstrap complete"
