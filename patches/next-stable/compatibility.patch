+"""Build the exact locked NumPy source with its internal BLAS/LAPACK fallback.
+
+No NumPy runtime code is patched. The Android wheel must not acquire an
+unbundled OpenBLAS dependency merely to supply arrays for microphone capture.
+Native wheel and numerical validation are separate gates from microphone use.
+"""
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+from typing import Callable
+from urllib.parse import urlsplit
+import urllib.request
+
+SDIST_SHA256 = "483a201202b73495f00dbc83796c6ae63137a9bdade074f7648b3e32613412dd"
+SDIST_SIZE = 20727743
+NUMPY_CONFIG_SETTINGS = (
+    "setup-args=-Dblas=none",
+    "setup-args=-Dlapack=none",
+    "setup-args=-Dallow-noblas=true",
+)
+
+
+def prepare_numpy_source(
+    requirement: str, work: Path, *, extract: Callable[[Path, Path], Path],
+) -> tuple[Path, dict[str, str]]:
+    """Admit the reviewed archive before any build backend can execute it."""
+    name, separator, artifact = requirement.partition(" @ ")
+    parsed = urlsplit(artifact)
+    if (
+        name != "numpy" or not separator or parsed.scheme != "https"
+        or parsed.netloc != "files.pythonhosted.org" or parsed.query
+        or not parsed.path.endswith("/numpy-2.4.3.tar.gz")
+        or parsed.fragment != "sha256=" + SDIST_SHA256
+    ):
+        raise ValueError("NumPy source must match the reviewed locked 2.4.3 sdist")
+    url = parsed._replace(fragment="").geturl()
+    with urllib.request.urlopen(url, timeout=60) as response:
+        data = response.read(SDIST_SIZE + 1)
+    if len(data) != SDIST_SIZE or hashlib.sha256(data).hexdigest() != SDIST_SHA256:
+        raise ValueError("NumPy source hash or size differs from the reviewed lock")
+    work.mkdir(parents=True, exist_ok=True)
+    archive = work / "numpy-2.4.3.tar.gz"
+    with archive.open("xb") as stream:
+        stream.write(data)
+    return extract(archive, work / "source"), {}
