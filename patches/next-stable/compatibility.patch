diff --git a/pm/bundled_wheels.py b/pm/bundled_wheels.py
new file mode 100644
index 00000000..c0e4cb6c
--- /dev/null
+++ b/pm/bundled_wheels.py
@@ -0,0 +1,353 @@
+"""Verified bundle wheels for frozen PM synchronization.
+
+The catalog is part of the sealed payload and is hashed by its manifest. It is
+not a uv cache: each row binds built wheel bytes to the original locked source.
+Only the current export's exact source and version may reuse a row.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import json
+from pathlib import Path
+import re
+from typing import Mapping, Sequence
+from urllib.parse import parse_qs, urlsplit, urlunsplit
+
+from pm.package import InstallError
+
+CATALOG_NAME = "bundled-wheels.json"
+
+
+
+def interpreter_markers(python: Path, environment: Mapping[str, str]) -> dict[str, str]:
+    """Read PEP 508 facts from the selected interpreter, without importing site."""
+    import subprocess
+
+    from pm.filesystem import native
+
+    code = """
+import json, os, platform, sys
+v = sys.implementation.version
+implementation_version = f"{v.major}.{v.minor}.{v.micro}"
+if v.releaselevel != "final":
+    implementation_version += v.releaselevel[0] + str(v.serial)
+print(json.dumps({
+    "implementation_name": sys.implementation.name,
+    "implementation_version": implementation_version,
+    "os_name": os.name,
+    "platform_machine": platform.machine(),
+    "platform_release": platform.release(),
+    "platform_system": platform.system(),
+    "platform_version": platform.version(),
+    "platform_python_implementation": platform.python_implementation(),
+    "python_full_version": platform.python_version(),
+    "python_version": ".".join(platform.python_version_tuple()[:2]),
+    "sys_platform": sys.platform,
+    "extra": "",
+}))
+"""
+    try:
+        result = subprocess.run([native(python), "-I", "-S", "-c", code],
+                                env=dict(environment), capture_output=True, text=True,
+                                encoding="utf-8", errors="replace", timeout=30, check=False)
+    except subprocess.TimeoutExpired as exc:
+        raise InstallError("venv", "selected Python marker inspection timed out") from exc
+    if result.returncode:
+        raise ValueError(f"selected Python marker inspection failed: {result.stderr[-600:]}")
+    markers = json.loads(result.stdout)
+    if not isinstance(markers, dict) or not all(isinstance(k, str) and isinstance(v, str) for k, v in markers.items()):
+        raise ValueError("selected Python returned malformed marker facts")
+    return markers
+
+def _hash(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+def _source_fingerprint(source: dict) -> str:
+    return _hash(json.dumps(source, sort_keys=True, separators=(",", ":")).encode())
+
+
+def _artifact(artifact: dict) -> dict:
+    url, digest = artifact.get("url"), artifact.get("hash")
+    if not isinstance(url, str) or not url or not isinstance(digest, str) or not re.fullmatch(r"sha256:[a-f0-9]{64}", digest):
+        raise ValueError("Bundled wheel origin needs an exact locked artifact URL and SHA-256")
+    return {"url": url, "sha256": digest[7:]}
+
+
+def _git_identity(url: str) -> tuple[str, str, str]:
+    parsed = urlsplit(url)
+    if not re.fullmatch(r"[a-f0-9]{40}", parsed.fragment):
+        raise ValueError("Bundled Git wheel needs an exact locked commit")
+    query = parse_qs(parsed.query)
+    repository = urlunsplit(parsed._replace(query="", fragment=""))
+    return repository, parsed.fragment, query.get("subdirectory", [""])[0]
+
+
+def _origin(package: dict, wheel_sha: str) -> dict:
+    source = package.get("source", {})
+    if "git" in source:
+        _git_identity(source["git"])
+        return {"kind": "git", "locked": source["git"]}
+    registry = source.get("registry")
+    if not isinstance(registry, str) or not registry:
+        raise ValueError(f"Unsupported bundled wheel source for {package['name']}")
+    matches = [w for w in package.get("wheels", []) if w.get("hash") == f"sha256:{wheel_sha}"]
+    if matches:
+        return {"kind": "registry-wheel", "registry": registry, **_artifact(matches[0])}
+    return {"kind": "registry-sdist", "registry": registry, **_artifact(package.get("sdist", {}))}
+
+
+def _origin_matches(origin: dict, package: dict) -> bool:
+    source = package.get("source", {})
+    if origin["kind"] == "git":
+        return source.get("git") == origin["locked"]
+    if source.get("registry") != origin["registry"]:
+        return False
+    artifacts = package.get("wheels", []) if origin["kind"] == "registry-wheel" else [package.get("sdist", {})]
+    return any(a.get("url") == origin["url"] and a.get("hash") == f"sha256:{origin['sha256']}" for a in artifacts)
+
+
+def _wheel_identity(path: Path) -> tuple[str, str]:
+    from email.parser import BytesParser
+    import zipfile
+
+    from packaging.utils import canonicalize_name, parse_wheel_filename
+    from packaging.version import Version
+
+    name, version, _build, _tags = parse_wheel_filename(path.name)
+    with zipfile.ZipFile(path) as wheel:
+        metadata = [n for n in wheel.namelist() if n.endswith(".dist-info/METADATA") and n.count("/") == 1]
+        if len(metadata) != 1:
+            raise ValueError(f"Expected one wheel metadata record: {path.name}")
+        record = BytesParser().parsebytes(wheel.read(metadata[0]))
+    if canonicalize_name(record["Name"] or "") != name or Version(record["Version"] or "") != version:
+        raise ValueError(f"Wheel filename and metadata disagree: {path.name}")
+    return name, str(version)
+
+
+def write_catalog(payload: Path, *, wheelhouse: Path, lock_paths: Sequence[Path]) -> dict:
+    """Write the build-time catalog; return its manifest descriptor.
+
+    Call after wheel retag/linkage repair and copy wheelhouse/ into the payload.
+    Then add the returned descriptor to manifest.json as bundled_wheels.
+    """
+    import tomllib
+
+    from packaging.utils import canonicalize_name
+    from packaging.version import Version
+
+    payload, wheelhouse = payload.resolve(), wheelhouse.resolve()
+    if wheelhouse != payload / "wheelhouse":
+        raise ValueError("Bundled wheels must be staged at payload/wheelhouse")
+    packages = [p for path in lock_paths
+                for p in tomllib.loads(path.read_text(encoding="utf-8-sig"))["package"]]
+    rows, identities = [], set()
+    for path in sorted(wheelhouse.glob("*.whl")):
+        if path.is_symlink() or not path.resolve().is_relative_to(payload):
+            raise ValueError(f"Bundled wheel must be an internal regular file: {path.name}")
+        name, version = _wheel_identity(path)
+        data = path.read_bytes()
+        digest = _hash(data)
+        candidates = [p for p in packages if canonicalize_name(p["name"]) == name and Version(p["version"]) == Version(version)]
+        origins = {}
+        for package in candidates:
+            origin = _origin(package, digest)
+            origins[_source_fingerprint(origin)] = (package, origin)
+        if len(origins) != 1:
+            raise ValueError(f"Expected one locked source for bundled {name}=={version}")
+        fingerprint, (package, origin) = next(iter(origins.items()))
+        identity = (name, package["version"], fingerprint)
+        if identity in identities:
+            raise ValueError(f"Ambiguous bundled wheel for {name}=={version}")
+        identities.add(identity)
+        rows.append({"name": name, "version": package["version"], "source": origin,
+                     "source_fingerprint": fingerprint, "file": path.relative_to(payload).as_posix(),
+                     "sha256": digest, "size": len(data)})
+    if not rows:
+        raise ValueError("Cannot publish an empty bundled wheel catalog")
+    body = (json.dumps({"schema_version": 1, "wheels": rows}, sort_keys=True, indent=2) + "\n").encode()
+    (payload / CATALOG_NAME).write_bytes(body)
+    return {"path": CATALOG_NAME, "sha256": _hash(body)}
+
+
+def _validate_origin(origin: dict) -> None:
+    kind = origin.get("kind")
+    if kind == "git":
+        if set(origin) != {"kind", "locked"} or not isinstance(origin["locked"], str):
+            raise ValueError("Malformed bundled Git source")
+        _git_identity(origin["locked"])
+    elif kind in ("registry-wheel", "registry-sdist"):
+        if set(origin) != {"kind", "registry", "url", "sha256"}:
+            raise ValueError("Malformed bundled registry source")
+        if not all(isinstance(origin[k], str) and origin[k] for k in ("registry", "url", "sha256")):
+            raise ValueError("Malformed bundled registry source")
+        if not re.fullmatch(r"[a-f0-9]{64}", origin["sha256"]):
+            raise ValueError("Malformed bundled source SHA-256")
+    else:
+        raise ValueError("Unsupported bundled wheel source kind")
+
+
+def _validate_row(row: dict, payload: Path) -> None:
+    from packaging.utils import canonicalize_name
+    from packaging.version import Version
+
+    if not isinstance(row, dict) or set(row) != {"name", "version", "source", "source_fingerprint", "file", "sha256", "size"}:
+        raise ValueError("Malformed bundled wheel catalog row")
+    if (not isinstance(row["name"], str) or not re.fullmatch(r"[a-z0-9](?:[a-z0-9-]*[a-z0-9])?", row["name"])
+            or canonicalize_name(row["name"]) != row["name"]):
+        raise ValueError("Bundled package name is not canonical")
+    if not isinstance(row["version"], str):
+        raise ValueError("Bundled version is not a string")
+    Version(row["version"])
+    if not isinstance(row["source"], dict):
+        raise ValueError("Malformed bundled source")
+    _validate_origin(row["source"])
+    if row["source_fingerprint"] != _source_fingerprint(row["source"]):
+        raise ValueError("Bundled source fingerprint mismatch")
