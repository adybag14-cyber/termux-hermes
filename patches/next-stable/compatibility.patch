--- /dev/null
+++ b/hermes_platform/resolver/termux_services.py
@@ -0,0 +1,49 @@
+"""Resolve Termux's native service tools without starting the shared supervisor."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import os
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class TermuxServices:
+    prefix: Path
+
+    @property
+    def sv(self) -> Path:
+        return self.prefix / "bin" / "sv"
+
+    @property
+    def daemon(self) -> Path:
+        return self.prefix / "bin" / "service-daemon"
+
+    @property
+    def shell(self) -> Path:
+        return self.prefix / "bin" / "sh"
+
+    @property
+    def services(self) -> Path:
+        return self.prefix / "var" / "service"
+
+    def environment(self) -> dict[str, str]:
+        # A bundled Python's old scoped libraries must never load into current
+        # APT runit/coreutils. Do not make the shared daemon inherit a CLI's
+        # selected profile, generation, Python overrides, or credentials.
+        env = {key: os.environ[key] for key in
+               ("HOME", "LANG", "TZ", "ANDROID_ROOT", "ANDROID_DATA")
+               if key in os.environ}
+        env.update(PREFIX=str(self.prefix), PATH=str(self.prefix / "bin"),
+                   SVDIR=str(self.services), LOGDIR=str(self.prefix / "var" / "log"),
+                   TMPDIR=str(self.prefix / "tmp"))
+        return env
+
+
+def resolve_termux_services(prefix: Path | None = None) -> TermuxServices | None:
+    """Resolve the official PREFIX layout; explicit paths are data for probes."""
+    raw = str(prefix) if prefix is not None else os.environ.get("PREFIX", "")
+    if not raw or not Path(raw).is_absolute():
+        return None
+    tools = TermuxServices(Path(raw).resolve())
+    return tools if all(path.is_file() and os.access(path, os.X_OK)
+                        for path in (tools.sv, tools.daemon, tools.shell)) else None
