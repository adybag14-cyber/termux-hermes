@@ -0,0 +1,85 @@
+"""Behavioral regressions for the two reviewed third-party build hooks."""
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from scripts.termux.compat_sources import patch_python_olm_source, patch_uvloop_source
+
+
+UVLOOP_HOOK = """\
+def commands(env):
+    autogen = ['/bin/sh', 'autogen.sh']
+    if 'LIBUV_CONFIGURE_HOST' in env:
+        cmd = ['./configure', '--host=' + env['LIBUV_CONFIGURE_HOST']]
+    else:
+        cmd = ['./configure']
+    return autogen, cmd
+"""
+
+
+@pytest.mark.parametrize("host", [None, "aarch64-linux-android"])
+def test_uvloop_backend_runs_both_scripts_with_configured_shell(tmp_path, host):
+    setup = tmp_path / "setup.py"
+    setup.write_text(UVLOOP_HOOK, encoding="utf-8")
+    shell = tmp_path / "termux-sh"
+    shell.write_text("fixture executable", encoding="utf-8")
+    patch_uvloop_source(tmp_path, shell)
+    namespace = {}
+    exec(compile(setup.read_text(encoding="utf-8"), str(setup), "exec"), namespace)
+    env = {"CONFIG_SHELL": str(shell)}
+    if host:
+        env["LIBUV_CONFIGURE_HOST"] = host
+    autogen, configure = namespace["commands"](env)
+    assert autogen == [str(shell), "autogen.sh"]
+    assert configure == [str(shell), "./configure"] + ([f"--host={host}"] if host else [])
+
+
+def test_olm_build_keeps_static_library_and_admits_modern_cmake(tmp_path):
+    hook = tmp_path / "olm_build.py"
+    hook.write_text(
+        'subprocess.run(["cmake", ".", "-Bbuild", "-DBUILD_SHARED_LIBS=NO"], '
+        'cwd="libolm", check=True)\n', encoding="utf-8",
+    )
+    header = tmp_path / "libolm/include/olm/list.hh"
+    header.parent.mkdir(parents=True)
+    header.write_text("T * const other_pos = other._data;\n", encoding="utf-8")
+    patch_python_olm_source(tmp_path)
+    calls = []
+    namespace = {"subprocess": SimpleNamespace(run=lambda *a, **kw: calls.append((a, kw)))}
+    exec(compile(hook.read_text(encoding="utf-8"), str(hook), "exec"), namespace)
+    args, kwargs = calls[0]
+    assert args[0] == ["cmake", ".", "-Bbuild", "-DBUILD_SHARED_LIBS=NO",
+                       "-DCMAKE_POLICY_VERSION_MINIMUM=3.5", "-DOLM_TESTS=OFF"]
+    assert kwargs == {"cwd": "libolm", "check": True}
+
+
+@pytest.mark.parametrize("change", ["missing", "duplicate"])
+def test_unknown_uvloop_build_hook_fails_without_partial_rewrite(tmp_path, change):
+    setup = tmp_path / "setup.py"
+    content = UVLOOP_HOOK.replace("cmd = ['./configure']", "cmd = ['changed']") if change == "missing" else UVLOOP_HOOK * 2
+    setup.write_text(content, encoding="utf-8")
+    shell = tmp_path / "termux-sh"
+    shell.touch()
+    with pytest.raises(ValueError, match="source-build hook changed"):
+        patch_uvloop_source(tmp_path, shell)
+    assert setup.read_text(encoding="utf-8") == content
+
+
+def test_unknown_olm_hook_is_not_silently_accepted(tmp_path):
+    path = tmp_path / "olm_build.py"
+    path.write_text('subprocess.run(["cmake", "--different"])\n', encoding="utf-8")
+    with pytest.raises(ValueError, match="source-build hook changed"):
+        patch_python_olm_source(tmp_path)
+
+
+def test_unknown_olm_cpp_hook_leaves_build_hook_unmodified(tmp_path):
+    hook = tmp_path / "olm_build.py"
+    original = 'subprocess.run(["cmake", ".", "-Bbuild", "-DBUILD_SHARED_LIBS=NO"])\n'
+    hook.write_text(original, encoding="utf-8")
+    header = tmp_path / "libolm/include/olm/list.hh"
+    header.parent.mkdir(parents=True)
+    header.write_text("changed upstream list implementation\n", encoding="utf-8")
+    with pytest.raises(ValueError, match="source-build hook changed"):
+        patch_python_olm_source(tmp_path)
+    assert hook.read_text(encoding="utf-8") == original
diff --git a/tests/scripts/test_termux_nemo_source.py b/tests/scripts/test_termux_nemo_source.py
new file mode 100644
index 00000000..7d4f2d74
--- /dev/null
+++ b/tests/scripts/test_termux_nemo_source.py
@@ -0,0 +1,187 @@
+"""NeMo source preparation preserves pins and actually selects the native protoc."""
+from __future__ import annotations
+
+import hashlib
+import io
+import os
+from pathlib import Path
+import subprocess
+import tarfile
+
+import pytest
+
+from scripts.termux import nemo_source
+from scripts.termux.build_wheels import safe_extract
+
+WORKER_PROTO = b"""// SPDX-FileCopyrightText: Copyright (c) 2026, NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Build script for the NeMo Relay worker gRPC protocol crate.
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let proto = "proto/nemo/relay/worker/v1/plugin_worker.proto";
+    let include = "proto";
+    let mut prost = prost_build::Config::new();
+    prost.protoc_executable(protoc_bin_vendored::protoc_bin_path()?);
+    prost.boxed(".nemo.relay.worker.v1.LlmInvocation.execution_codec_context");
+
+    tonic_prost_build::configure().compile_with_config(prost, &[proto], &[include])?;
+    Ok(())
+}
+"""
+
+# Compile and run the actual patched Rust build script with small stand-ins
+# for its build dependencies. The old vendored path fails; the new path must
+# pass the caller's compiler through to the protobuf generator.
+RUST_BUILD_DEPENDENCIES = r"""
+mod prost_build {
+    pub struct Config { pub executable: Option<std::path::PathBuf> }
+    impl Config {
+        pub fn new() -> Self { Self { executable: None } }
+        pub fn protoc_executable(&mut self, executable: std::path::PathBuf) {
+            self.executable = Some(executable);
+        }
+        pub fn boxed(&mut self, _: &str) {}
+    }
+}
+mod protoc_bin_vendored {
+    pub fn protoc_bin_path() -> Result<std::path::PathBuf, Box<dyn std::error::Error>> {
+        Err("vendored protoc unavailable".into())
+    }
+}
+mod tonic_prost_build {
+    pub struct Builder;
+    pub fn configure() -> Builder { Builder }
+    impl Builder {
+        pub fn compile_with_config(
+            self, config: crate::prost_build::Config, _: &[&str], _: &[&str],
+        ) -> Result<(), Box<dyn std::error::Error>> {
+            println!("selected-protoc={}", config.executable.unwrap().display());
+            Ok(())
+        }
+    }
+}
+"""
+
+
+def _worker_source(root):
+    path = root / "crates/worker-proto/build.rs"
+    path.parent.mkdir(parents=True)
+    path.write_bytes(WORKER_PROTO)
+    return path
+
+
+def _archive_fixture(monkeypatch):
+    stream = io.BytesIO()
+    with tarfile.open(fileobj=stream, mode="w:gz") as archive:
+        entries = {
+            "nemo_relay-0.10.0/crates/worker-proto/build.rs": WORKER_PROTO,
+            "nemo_relay-0.10.0/Cargo.lock": b"unchanged lock fixture\n",
+        }
+        for name, content in entries.items():
+            info = tarfile.TarInfo(name)
+            info.size = len(content)
+            archive.addfile(info, io.BytesIO(content))
+    data = stream.getvalue()
+    sha = hashlib.sha256(data).hexdigest()
+    monkeypatch.setattr(nemo_source, "SDIST_SHA256", sha)
+    monkeypatch.setattr(nemo_source, "SDIST_SIZE", len(data))
+    requirement = f"nemo-relay @ https://example.invalid/locked.tar.gz#sha256={sha}"
+    return data, requirement
+
+
+def test_verified_preparation_preserves_lock_and_validates_compiler(tmp_path, monkeypatch):
+    data, requirement = _archive_fixture(monkeypatch)
+    compiler = tmp_path / "protoc"
+    compiler.touch()
+    monkeypatch.setenv("PROTOC", str(compiler))
+    calls = []
+
+    def compiler_probe(command, **kwargs):
+        calls.append(command)
+        return subprocess.CompletedProcess(command, 0, stdout="libprotoc 32.0\n", stderr="")
+
+    monkeypatch.setattr(nemo_source.subprocess, "run", compiler_probe)
+    monkeypatch.setattr(nemo_source.urllib.request, "urlopen", lambda *_a, **_k: io.BytesIO(data))
+    source, environment = nemo_source.prepare_nemo_source(
+        requirement, tmp_path / "build", extract=safe_extract)
+    assert environment == {"PROTOC": str(compiler.resolve())}
+    assert calls == [[str(compiler.resolve()), "--version"]]
+    assert (source / "Cargo.lock").read_bytes() == b"unchanged lock fixture\n"
+
+
+@pytest.mark.parametrize("failure", ["unreviewed-pin", "corrupt-bytes", "oversized"])
+def test_source_tampering_fails_before_extraction(tmp_path, monkeypatch, failure):
+    data, requirement = _archive_fixture(monkeypatch)
+    monkeypatch.setattr(nemo_source, "_validated_protoc", lambda: tmp_path / "protoc")
+    if failure == "unreviewed-pin":
+        requirement = requirement.rsplit("=", 1)[0] + "=" + "0" * 64
+    elif failure == "corrupt-bytes":
+        data = data[:-1] + bytes([data[-1] ^ 1])
+    else:
+        data += b"x"
+    monkeypatch.setattr(nemo_source.urllib.request, "urlopen", lambda *_a, **_k: io.BytesIO(data))
+    with pytest.raises(ValueError, match="reviewed|hash|size"):
+        nemo_source.prepare_nemo_source(requirement, tmp_path / "build", extract=safe_extract)
+    assert not (tmp_path / "build").exists()
+
+
+@pytest.mark.parametrize("version", ["Python 3.14.0", "libprotoc 3.14.0", ""])
+def test_invalid_compiler_is_refused(tmp_path, monkeypatch, version):
+    compiler = tmp_path / "protoc"
+    compiler.touch()
+    monkeypatch.setenv("PROTOC", str(compiler))
+    monkeypatch.setattr(nemo_source.subprocess, "run", lambda command, **_k:
+                        subprocess.CompletedProcess(command, 0, stdout=version, stderr=""))
+    with pytest.raises(ValueError, match="protobuf compiler"):
+        nemo_source._validated_protoc()
+
+
+@pytest.mark.parametrize("declaration", ["", "relative-protoc", "missing-absolute"])
+def test_missing_or_ambiguous_compiler_is_refused(tmp_path, monkeypatch, declaration):
+    value = str(tmp_path / "missing") if declaration == "missing-absolute" else declaration
+    monkeypatch.setenv("PROTOC", value)
+    with pytest.raises(ValueError, match="absolute existing"):
+        nemo_source._validated_protoc()
+
+
+def test_unreviewed_worker_source_is_not_modified(tmp_path):
+    source = _worker_source(tmp_path)
+    changed = WORKER_PROTO + b"// different upstream release\n"
+    source.write_bytes(changed)
+    with pytest.raises(ValueError, match="Unreviewed"):
+        nemo_source.patch_worker_proto(tmp_path)
+    assert source.read_bytes() == changed
+
+
+def test_actual_rust_build_script_uses_validated_protoc(tmp_path):
+    source = _worker_source(tmp_path)
+    env = {key: value for key, value in os.environ.items() if key != "PROTOC"}
+    env["PROTOC"] = str(tmp_path / "native protoc")
+    executable = tmp_path / ("build-script.exe" if os.name == "nt" else "build-script")
+
+    def compile_and_run(body, environment):
+        program = tmp_path / "build-script.rs"
+        program.write_bytes(body + RUST_BUILD_DEPENDENCIES.encode())
+        subprocess.run(
+            ["rustc", "--edition", "2024", "--crate-name", "nemo_build_probe",
+             str(program), "-o", str(executable)],
+            check=True, capture_output=True, text=True, timeout=45,
+        )
+        return subprocess.run(
+            [str(executable)], env=environment, capture_output=True, text=True, timeout=10)
+
+    before = compile_and_run(WORKER_PROTO, env)
+    assert before.returncode != 0
+    assert "vendored protoc unavailable" in before.stderr
+    nemo_source.patch_worker_proto(tmp_path)
+    # build.rs is the transformed test input, not the Python implementation.
+    after = compile_and_run(source.read_bytes(), env)
+    assert after.returncode == 0, after.stderr
+    assert "selected-protoc=" + env["PROTOC"] in after.stdout
+    without_compiler = subprocess.run(
+        [str(executable)], env={key: value for key, value in env.items() if key != "PROTOC"},
+        capture_output=True, text=True, timeout=10,
+    )
+    assert without_compiler.returncode != 0
+    assert "validated PROTOC" in without_compiler.stderr
