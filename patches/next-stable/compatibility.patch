@@ -0,0 +1,70 @@
+"""Behavioral regressions for the two reviewed third-party build hooks."""
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from scripts.termux.compat_sources import patch_python_olm_source, patch_uvloop_source
+
+
+UVLOOP_HOOK = """\
+def commands(env):
+    autogen = ['/bin/sh', 'autogen.sh']
+    if 'LIBUV_CONFIGURE_HOST' in env:
+        cmd = ['./configure', '--host=' + env['LIBUV_CONFIGURE_HOST']]
+    else:
+        cmd = ['./configure']
+    return autogen, cmd
+"""
+
+
+@pytest.mark.parametrize("host", [None, "aarch64-linux-android"])
+def test_uvloop_backend_runs_both_scripts_with_configured_shell(tmp_path, host):
+    setup = tmp_path / "setup.py"
+    setup.write_text(UVLOOP_HOOK, encoding="utf-8")
+    shell = tmp_path / "termux-sh"
+    shell.write_text("fixture executable", encoding="utf-8")
+    patch_uvloop_source(tmp_path, shell)
+    namespace = {}
+    exec(compile(setup.read_text(encoding="utf-8"), str(setup), "exec"), namespace)
+    env = {"CONFIG_SHELL": str(shell)}
+    if host:
+        env["LIBUV_CONFIGURE_HOST"] = host
+    autogen, configure = namespace["commands"](env)
+    assert autogen == [str(shell), "autogen.sh"]
+    assert configure == [str(shell), "./configure"] + ([f"--host={host}"] if host else [])
+
+
+def test_olm_build_keeps_static_library_and_admits_modern_cmake(tmp_path):
+    hook = tmp_path / "olm_build.py"
+    hook.write_text(
+        'subprocess.run(["cmake", ".", "-Bbuild", "-DBUILD_SHARED_LIBS=NO"], '
+        'cwd="libolm", check=True)\n', encoding="utf-8",
+    )
+    patch_python_olm_source(tmp_path)
+    calls = []
+    namespace = {"subprocess": SimpleNamespace(run=lambda *a, **kw: calls.append((a, kw)))}
+    exec(compile(hook.read_text(encoding="utf-8"), str(hook), "exec"), namespace)
+    args, kwargs = calls[0]
+    assert args[0] == ["cmake", ".", "-Bbuild", "-DBUILD_SHARED_LIBS=NO",
+                       "-DCMAKE_POLICY_VERSION_MINIMUM=3.5", "-DOLM_TESTS=OFF"]
+    assert kwargs == {"cwd": "libolm", "check": True}
+
+
+@pytest.mark.parametrize("change", ["missing", "duplicate"])
+def test_unknown_uvloop_build_hook_fails_without_partial_rewrite(tmp_path, change):
+    setup = tmp_path / "setup.py"
+    content = UVLOOP_HOOK.replace("cmd = ['./configure']", "cmd = ['changed']") if change == "missing" else UVLOOP_HOOK * 2
+    setup.write_text(content, encoding="utf-8")
+    shell = tmp_path / "termux-sh"
+    shell.touch()
+    with pytest.raises(ValueError, match="source-build hook changed"):
+        patch_uvloop_source(tmp_path, shell)
+    assert setup.read_text(encoding="utf-8") == content
+
+
+def test_unknown_olm_hook_is_not_silently_accepted(tmp_path):
+    path = tmp_path / "olm_build.py"
+    path.write_text('subprocess.run(["cmake", "--different"])\n', encoding="utf-8")
+    with pytest.raises(ValueError, match="source-build hook changed"):
+        patch_python_olm_source(tmp_path)
