+++ b/tests/scripts/test_termux_numpy_source.py
@@ -0,0 +1,92 @@
+"""NumPy source admission keeps the reviewed lock authoritative before build hooks."""
+from __future__ import annotations
+
+import hashlib
+import io
+from pathlib import Path
+import tomllib
+
+import pytest
+
+from scripts.termux import numpy_source
+
+URL = "https://files.pythonhosted.org/packages/reviewed/numpy-2.4.3.tar.gz"
+
+
+def test_numpy_source_pin_matches_the_repository_lock():
+    root = Path(__file__).resolve().parents[2]
+    lock = tomllib.loads((root / "uv.lock").read_text(encoding="utf-8"))
+    package = next(row for row in lock["package"] if row["name"] == "numpy")
+    assert package["version"] == "2.4.3"
+    assert package["sdist"]["hash"] == "sha256:" + numpy_source.SDIST_SHA256
+    assert package["sdist"]["size"] == numpy_source.SDIST_SIZE
+
+
+@pytest.fixture
+def reviewed_payload(monkeypatch):
+    # Supply deterministic downloaded bytes; the real digest and size checks
+    # still run before the safe extractor or a build backend can see them.
+    data = b"reviewed source fixture"
+    monkeypatch.setattr(numpy_source, "SDIST_SHA256", hashlib.sha256(data).hexdigest())
+    monkeypatch.setattr(numpy_source, "SDIST_SIZE", len(data))
+    return data
+
+
+def test_verified_archive_reaches_the_safe_extractor_unchanged(tmp_path, monkeypatch, reviewed_payload):
+    requests = []
+    def download(url, **kwargs):
+        requests.append((url, kwargs))
+        return io.BytesIO(reviewed_payload)
+    monkeypatch.setattr(numpy_source.urllib.request, "urlopen", download)
+    extracted = []
+    def extract(archive, directory):
+        assert archive.read_bytes() == reviewed_payload
+        extracted.append((archive, directory))
+        directory.mkdir()
+        return directory
+    source, env = numpy_source.prepare_numpy_source(
+        "numpy @ " + URL + "#sha256=" + numpy_source.SDIST_SHA256,
+        tmp_path / "build", extract=extract,
+    )
+    assert source == tmp_path / "build/source" and env == {}
+    assert requests == [(URL, {"timeout": 60})]
+    assert len(extracted) == 1
+
+
+def test_tampered_download_never_reaches_the_extractor(tmp_path, monkeypatch, reviewed_payload):
+    monkeypatch.setattr(numpy_source.urllib.request, "urlopen", lambda *a, **k: io.BytesIO(b"x" * len(reviewed_payload)))
+    with pytest.raises(ValueError, match="hash or size"):
+        numpy_source.prepare_numpy_source(
+            "numpy @ " + URL + "#sha256=" + numpy_source.SDIST_SHA256,
+            tmp_path / "build", extract=lambda *a: pytest.fail("unverified source reached extraction"),
+        )
+    assert not (tmp_path / "build").exists()
+
+
+@pytest.mark.parametrize("url", [
+    "http://files.pythonhosted.org/packages/reviewed/numpy-2.4.3.tar.gz",
+    "https://example.com/numpy-2.4.3.tar.gz",
+    "https://files.pythonhosted.org@evil.example/numpy-2.4.3.tar.gz",
+    "https://files.pythonhosted.org/packages/reviewed/numpy-2.4.4.tar.gz",
+    URL + "?replacement=1",
+])
+def test_unreviewed_location_is_rejected_before_network(tmp_path, monkeypatch, url):
+    monkeypatch.setattr(numpy_source.urllib.request, "urlopen", lambda *a, **k: pytest.fail("unreviewed network request"))
+    with pytest.raises(ValueError, match="reviewed locked"):
+        numpy_source.prepare_numpy_source(
+            "numpy @ " + url + "#sha256=" + numpy_source.SDIST_SHA256,
+            tmp_path, extract=lambda *a: pytest.fail("unreviewed extraction"),
+        )
+
+
+def test_response_read_is_bounded_before_digest_verification(tmp_path, monkeypatch, reviewed_payload):
+    class Oversized(io.BytesIO):
+        def read(self, size=-1):
+            assert size == numpy_source.SDIST_SIZE + 1
+            return super().read(size)
+    monkeypatch.setattr(numpy_source.urllib.request, "urlopen", lambda *a, **k: Oversized(reviewed_payload + b"extra"))
+    with pytest.raises(ValueError, match="hash or size"):
+        numpy_source.prepare_numpy_source(
+            "numpy @ " + URL + "#sha256=" + numpy_source.SDIST_SHA256,
+            tmp_path, extract=lambda *a: pytest.fail("oversized archive reached extraction"),
+        )
