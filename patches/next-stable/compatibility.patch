+++ b/tools/voice_mode_termux.py
@@ -0,0 +1,138 @@
+"""Termux:API media playback and the microphone service's integer duration limit.
+
+The Android player is asynchronous: its CLI exits when playback starts. Keep the
+call active until the service reports completion so interruption and TTS output
+tracking cover the actual audio. This does not supply PCM capture or silence VAD.
+"""
+
+from __future__ import annotations
+
+import logging
+import math
+import os
+import subprocess
+import threading
+import time
+from collections.abc import Callable
+
+logger = logging.getLogger(__name__)
+
+
+def recording_limit_seconds(value: object) -> float:
+    """Return a bounded positive cap, or zero for an unset/invalid setting.
+
+    Termux:API transports milliseconds in a signed Java int and rounds durations
+    below one second up to one second. A Python deadline preserves fractional caps.
+    """
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return 0.0
+    if not math.isfinite(value) or value <= 0:
+        return 0.0
+    return min(float(value), 2_147_483.0)
+
+
+class TermuxMediaPlayback:
+    """A stoppable handle for one Android media-player request."""
+
+    def __init__(self, command: str, file_path: str, env: dict[str, str], *,
+                 run: Callable = subprocess.run) -> None:
+        self.command = command
+        self.file_path = os.path.abspath(file_path)
+        self.track = os.path.basename(self.file_path)
+        self.env = env
+        self._run = run
+        self._cancel = threading.Event()
+        self.returncode: int | None = None
+
+    def poll(self) -> int | None:
+        return self.returncode
+
+    def terminate(self) -> None:
+        # The playback thread owns API calls. Waking it avoids a race in which
+        # "stop" overtakes the asynchronous "play" request and leaves audio going.
+        self._cancel.set()
+
+    def _call(self, *args: str) -> str:
+        result = self._run(
+            [self.command, *args], stdin=subprocess.DEVNULL, capture_output=True,
+            text=True, encoding="utf-8", errors="replace", timeout=10, check=False,
+            env=self.env,
+        )
+        if result.returncode:
+            raise RuntimeError((result.stderr or result.stdout or
+                                f"Termux:API exited with {result.returncode}").strip())
+        return result.stdout.strip()
+
+    def _track_state(self) -> tuple[str | None, str | None]:
+        output = self._call("info")
+        if output == "No track currently!":
+            return None, None
+        fields = dict(line.split(": ", 1) for line in output.splitlines() if ": " in line)
+        if fields.get("Status") not in ("Playing", "Paused") or "Track" not in fields:
+            # Termux:API can report a permission/service error with exit status 0.
+            raise RuntimeError(output or "Termux:API returned no playback status")
+        return fields["Track"], fields["Status"]
+
+    def _stop_if_ours(self) -> None:
+        # The service is shared with other Termux clients. It exposes only a
+        # basename, so never stop a differently named track that replaced ours.
+        try:
+            track, _ = self._track_state()
+            if track == self.track:
+                self._call("stop")
+        except (OSError, subprocess.SubprocessError, RuntimeError) as exc:
+            logger.warning("Could not stop Termux:API playback: %s", exc)
+
+    def wait(self, timeout: float = 300) -> bool:
+        """Start and await playback; an intentional interruption is handled success."""
+        succeeded = False
+        started = False
+        try:
+            if self._cancel.is_set():
+                succeeded = True
+                return True
+            output = self._call("play", self.file_path)
+            if not output.startswith("Now Playing: "):
+                raise RuntimeError(output or "Termux:API did not acknowledge playback")
+            started = True
+            deadline = time.monotonic() + timeout
+            while True:
+                if self._cancel.is_set():
+                    self._stop_if_ours()
+                    succeeded = True
+                    return True
+                track, _ = self._track_state()
+                if track is None or track != self.track:
+                    # A different actor may replace the global player. Treat
+                    # that as interruption, without touching their new track.
+                    succeeded = True
+                    return True
+                if time.monotonic() >= deadline:
+                    raise TimeoutError("Termux:API playback timed out")
+                self._cancel.wait(0.2)
+        except (OSError, subprocess.SubprocessError, RuntimeError) as exc:
+            logger.warning("Termux:API playback failed: %s", exc)
+            if started:
+                self._stop_if_ours()
+            return False
+        finally:
+            self.returncode = 0 if succeeded else 1
+
+
+def play_termux_audio(file_path: str, set_active: Callable) -> bool:
+    """Try the installed Termux:API player with a credential-scrubbed child env."""
+    from hermes_platform.resolver import locate_command
+    from tools.environments.local import hermes_subprocess_env
+
+    resolution = locate_command("termux-media-player")
+    if not resolution.found:
+        return False
+    player = TermuxMediaPlayback(
+        resolution.command[0], file_path,
+        hermes_subprocess_env(inherit_credentials=False),
+    )
+    set_active(player)
+    try:
+        return player.wait()
+    finally:
+        set_active(None)
