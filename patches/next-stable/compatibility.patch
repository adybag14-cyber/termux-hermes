--- /dev/null
+++ b/tools/bot_desktop/termux.py
@@ -0,0 +1,88 @@
+"""Termux's user-owned X11 desktop packages and native process environment.
+
+This drives a private Xvnc desktop. It does not capture or control Android phone apps.
+"""
+
+from __future__ import annotations
+
+import os
+import shlex
+import subprocess
+import tempfile
+from collections.abc import Mapping
+from pathlib import Path
+
+from hermes_platform.host.runtime import is_termux
+from hermes_platform.resolver import locate_command
+
+BINARY_PACKAGES = {
+    "Xvnc": "tigervnc", "xfwm4": "xfwm4", "xfce4-panel": "xfce4-panel",
+    "xfdesktop": "xfdesktop", "xfsettingsd": "xfce4-settings", "dbus-run-session": "dbus",
+    "xauth": "xorg-xauth", "xdpyinfo": "xorg-xdpyinfo",
+    "setxkbmap": "xorg-setxkbmap", "xprop": "xorg-xprop",
+}
+PACKAGES = [
+    "tigervnc", "xfwm4", "xfce4-panel", "xfdesktop", "xfce4-settings", "xfce4-terminal",
+    "dbus", "xorg-xauth", "xorg-xdpyinfo", "xorg-setxkbmap", "xorg-xprop",
+    "xorg-xsetroot", "ttf-dejavu", "scrot",
+]
+
+
+def prefix() -> Path:
+    return Path(os.environ.get("PREFIX") or "/data/data/com.termux/files/usr")
+
+
+def x_lock_dir(*, termux: bool | None = None, system_prefix: Path | None = None) -> Path:
+    if is_termux() if termux is None else termux:
+        return (prefix() if system_prefix is None else system_prefix) / "tmp"
+    return Path("/tmp")  # no-tmp: ok — the ordinary Linux X server's compiled lock location
+
+
+def install_command() -> str:
+    """Enable the signed official X11 repo before resolving its packages, without sudo."""
+    apt = "apt-get -o Acquire::Retries=5"
+    script = (
+        "set -e; "
+        f"{apt} install -y --no-remove --no-install-recommends x11-repo; "
+        f"{apt} -o APT::Update::Error-Mode=any update; "
+        f"{apt} install -y --no-remove --no-install-recommends " + " ".join(PACKAGES)
+    )
+    return shlex.join(["bash", "-c", script])
+
+
+def system_env(base: Mapping[str, str], *, termux: bool | None = None) -> dict[str, str]:
+    """APT X11 binaries use their current system libraries, independently of the Hermes bundle."""
+    env = dict(base)
+    if is_termux() if termux is None else termux:
+        env.pop("LD_LIBRARY_PATH", None)
+    return env
+
+
+def launcher_env(base: Mapping[str, str], *, termux: bool | None = None,
+                 system_prefix: Path | None = None) -> dict[str, str]:
+    enabled = is_termux() if termux is None else termux
+    env = system_env(base, termux=enabled)
+    if enabled:
+        root = prefix() if system_prefix is None else system_prefix
+        env.update(HERMES_BD_XLOCK_DIR=str(root / "tmp"), HERMES_BD_SYSTEM_SHARE=str(root / "share"))
+    return env
+
+
+def grab_x11_image(published: Mapping[str, str]):
+    """Capture only this profile's X display, without requiring Pillow's optional XCB extension."""
+    resolution = locate_command("scrot")
+    if not resolution.found:
+        raise RuntimeError("Bot Desktop thumbnails on Termux require the scrot package; run hermes screen install.")
+    from PIL import Image
+    from tools.environments.local import served_profile_child_env
+    env = system_env(served_profile_child_env(inherit_credentials=False), termux=True)
+    env.update(published)
+    env.pop("WAYLAND_DISPLAY", None)
+    with tempfile.TemporaryDirectory(prefix="hermes-x11-") as scratch:
+        target = Path(scratch) / "screen.png"
+        subprocess.run(
+            [*resolution.command, "--silent", "--overwrite", str(target)], env=env, stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=10, check=True,
+        )
+        with Image.open(target) as image:
+            return image.copy()
