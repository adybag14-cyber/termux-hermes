+"""Termux text clipboard selection and failure fallback use explicit host facts."""
+
+import subprocess
+
+from hermes_cli import clipboard
+
+
+def test_termux_clipboard_uses_native_api_with_utf8_stdin():
+    data = "hello 日本語 🎤\n".encode("utf-8")
+    commands = clipboard._write_clipboard_commands(data, platform="android", termux=True)
+    assert commands[0] == (["termux-clipboard-set"], {"input": data})
+    assert any(argv[0] == "xclip" for argv, _ in commands)
+
+
+def test_writer_falls_back_when_termux_api_is_missing_or_blocked(monkeypatch):
+    calls = []
+    commands = clipboard._write_clipboard_commands(b"text", platform="android", termux=True)
+    monkeypatch.setattr(clipboard, "_write_clipboard_commands", lambda data: commands)
+
+    def run(argv, **kwargs):
+        calls.append(argv[0])
+        assert kwargs["timeout"] == 10
+        if argv[0] == "termux-clipboard-set":
+            raise subprocess.TimeoutExpired(argv, 10)
+        return subprocess.CompletedProcess(argv, 0)
+
+    monkeypatch.setattr(clipboard.subprocess, "run", run)
+    assert clipboard.write_clipboard_text("text")
+    assert calls[:2] == ["termux-clipboard-set", "xclip"]
