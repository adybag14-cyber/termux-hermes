diff --git a/tools/voice_mode_capture.py b/tools/voice_mode_capture.py
new file mode 100644
index 00000000..30b63355
--- /dev/null
+++ b/tools/voice_mode_capture.py
@@ -0,0 +1,125 @@
+"""Explicit recorder choice and diagnostics; the configured transcription provider is unchanged."""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Callable, Mapping
+
+_BACKENDS = {"auto", "sounddevice", "termux-api"}
+
+
+def choose_backend(config: Mapping[str, object], *, termux_available: Callable[[], bool]) -> str:
+    raw = config.get("capture_backend", "auto")
+    name = raw.strip().lower() if isinstance(raw, str) else ""
+    if name not in _BACKENDS:
+        raise ValueError("voice.capture_backend must be auto, sounddevice, or termux-api.")
+    if name == "auto":
+        return "termux-api" if termux_available() else "sounddevice"
+    return name
+
+
+def capture_requirements(config: Mapping[str, object]) -> dict:
+    from tools import voice_mode as vm
+    try:
+        backend = choose_backend(config, termux_available=vm._termux_voice_capture_available)
+    except ValueError as exc:
+        return {"available": False, "detail": f"Audio capture: MISSING ({exc})", "missing_packages": []}
+    if backend == "termux-api":
+        available = vm._termux_voice_capture_available()
+        detail = ("Audio capture: OK (Termux:API microphone)" if available else
+                  "Audio capture: MISSING (termux-api package and Termux:API Android app required)")
+        return {"available": available, "detail": detail, "missing_packages": []}
+    available = vm._audio_available()
+    detail = ("Audio capture: OK (sounddevice / PortAudio)" if available else
+              f"Audio capture: MISSING ({vm._audio_unavailable_reason()})")
+    return {"available": available, "detail": detail,
+            "missing_packages": [] if available else ["sounddevice", "numpy"]}
+
+
+def _termux_environment() -> dict:
+    from tools import voice_mode as vm
+    warnings = []
+    if not vm._termux_microphone_command():
+        warnings.append("Termux:API capture requires the termux-api package: pkg install termux-api")
+    elif not vm._termux_api_app_installed():
+        warnings.append(vm._TERMUX_APP_MISSING_WARNING)
+    notices = ([] if warnings else
+               ["Termux:API microphone capture selected; Android permissions are checked when recording starts."])
+    return {"available": not warnings, "warnings": warnings, "notices": notices}
+
+
+def detect_audio_environment(config: Mapping[str, object]) -> dict:
+    from tools import voice_mode as vm
+    try:
+        backend = choose_backend(config, termux_available=vm._termux_voice_capture_available)
+    except ValueError as exc:
+        return {"available": False, "warnings": [str(exc)], "notices": []}
+    if backend == "termux-api":
+        return _termux_environment()
+    requested = config.get("capture_backend", "auto")
+    return _sounddevice_environment(api_fallback=isinstance(requested, str) and requested.strip().lower() == "auto")
+
+
+def _sounddevice_environment(*, api_fallback: bool = False) -> dict:
+    """Return ``{'available', 'warnings' (hard-fail, block voice), 'notices' (informational)}``.
+
+    SSH, containers and WSL normally have no audio devices, but a reachable sound
+    server (PulseAudio/PipeWire socket or forwarding env vars) is honored.
+    """
+    from tools import voice_mode as vm
+    warnings, notices = [], []
+    termux_mic_cmd = vm._termux_microphone_command() if api_fallback else None
+    termux_app_installed = vm._termux_api_app_installed() if termux_mic_cmd else False
+    has_forwarded_audio = bool(
+        os.environ.get('PULSE_SERVER') or os.environ.get('PIPEWIRE_REMOTE') or vm._pulse_socket_reachable())
+
+    def report(notice: str, warning: str) -> None:
+        (notices if has_forwarded_audio else warnings).append(notice if has_forwarded_audio else warning)
+
+    # SSH detection -- normally no audio devices, but honor a reachable sound server (PulseAudio/PipeWire
+    # socket or forwarding env vars), which works fine over SSH (issue #35622).
+    if any(os.environ.get(v) for v in ('SSH_CLIENT', 'SSH_TTY', 'SSH_CONNECTION')):
+        report("Running over SSH with a reachable PulseAudio/PipeWire sound server",
+               "Running over SSH -- no audio devices available.\n"
+               "  If a sound server (PulseAudio/PipeWire) is running on this host,\n"
+               "  point Hermes at it, e.g.:\n"
+               "    export XDG_RUNTIME_DIR=/run/user/$(id -u)\n"
+               "    # or: export PULSE_SERVER=unix:$XDG_RUNTIME_DIR/pulse/native")
+
+    # Docker/Podman container detection — honor host audio forwarding. When the user mounts a
+    # PulseAudio/PipeWire socket into the container and points PULSE_SERVER / PIPEWIRE_REMOTE at it, audio
+    # works fine (issue #21203). Only block when no forwarding is configured.
+    from hermes_constants import is_container
+    if is_container():
+        report("Running inside container (Docker/Podman/LXC) with host audio forwarding",
+               "Running inside container (Docker/Podman/LXC) -- no audio devices.\n"
+               "  Forward host audio with one of (substitute $XDG_RUNTIME_DIR for your runtime dir,\n"
+               "  typically /run/user/$UID):\n"
+               "    PulseAudio:  -v $XDG_RUNTIME_DIR/pulse/native:$XDG_RUNTIME_DIR/pulse/native \\\n"
+               "                 -e PULSE_SERVER=unix:$XDG_RUNTIME_DIR/pulse/native\n"
+               "    PipeWire:    -e PIPEWIRE_REMOTE=$XDG_RUNTIME_DIR/pipewire-0")
+
+    # WSL: the PowerShell/Media.SoundPlayer fallback only covers OUTPUT, so when
+    # it is all that's available downgrade to a notice (recording guidance stays
+    # visible, TTS-only usage isn't blocked).
+    if vm.is_wsl():
+        if has_forwarded_audio:
+            notices.append("Running in WSL with a reachable PulseAudio/PipeWire sound server")
+        elif vm._wsl_powershell_tts_available():
+            notices.append(
+                "Running in WSL without a PulseAudio bridge -- TTS playback "
+                "will use the PowerShell/Media.SoundPlayer fallback. "
+                "Voice INPUT (recording) still requires a PulseAudio bridge:\n"
+                "  1. Set PULSE_SERVER=unix:/mnt/wslg/PulseServer\n"
+                "  2. Create ~/.asoundrc pointing ALSA at PulseAudio\n"
+                "  3. Verify with: arecord -d 3 test.wav && aplay test.wav")
+        else:
