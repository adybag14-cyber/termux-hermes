+"""Recorder selection honors explicit choices and reports their own missing prerequisites."""
+
+import pytest
+
+from tools import voice_mode as vm
+from tools import voice_mode_capture as capture
+
+
+def unexpected_probe():
+    pytest.fail("an explicitly selected backend must not probe the alternative")
+
+
+def test_auto_retains_api_preference_and_pcm_fallback():
+    assert capture.choose_backend({}, termux_available=lambda: True) == "termux-api"
+    assert capture.choose_backend({}, termux_available=lambda: False) == "sounddevice"
+
+
+@pytest.mark.parametrize("name", ["sounddevice", "termux-api"])
+def test_explicit_choice_does_not_probe_an_alternative(name):
+    assert capture.choose_backend({"capture_backend": name}, termux_available=unexpected_probe) == name
+
+
+@pytest.mark.parametrize("value", [None, True, 1, "speech-recognizer"])
+def test_invalid_choice_reports_the_supported_configuration(value):
+    with pytest.raises(ValueError, match="voice.capture_backend"):
+        capture.choose_backend({"capture_backend": value}, termux_available=unexpected_probe)
+
+
+@pytest.mark.parametrize("name, expected", [("sounddevice", vm.AudioRecorder), ("termux-api", vm.TermuxAudioRecorder)])
+def test_factory_instantiates_the_explicit_backend_without_starting_a_microphone(monkeypatch, name, expected):
+    monkeypatch.setattr(vm, "_voice_config", lambda: {"capture_backend": name})
+    monkeypatch.setattr(vm, "_termux_voice_capture_available", unexpected_probe)
+    assert isinstance(vm.create_audio_recorder(), expected)
+
+
+def test_available_api_cannot_mask_missing_pcm_dependencies(monkeypatch):
+    monkeypatch.setattr(vm, "_termux_voice_capture_available", unexpected_probe)
+    monkeypatch.setattr(vm, "_audio_available", lambda: False)
+    monkeypatch.setattr(vm, "_audio_unavailable_reason", lambda: "NumPy native wheel is not available")
+    result = capture.capture_requirements({"capture_backend": "sounddevice"})
+    assert not result["available"]
+    assert result["missing_packages"] == ["sounddevice", "numpy"]
+    assert "NumPy native wheel" in result["detail"]
+
+
+def test_api_capture_does_not_import_or_provision_pcm_dependencies(monkeypatch):
+    monkeypatch.setattr(vm, "_termux_voice_capture_available", lambda: True)
+    monkeypatch.setattr(vm, "_audio_available", unexpected_probe)
+    result = capture.capture_requirements({"capture_backend": "termux-api"})
+    assert result["available"] and not result["missing_packages"]
+    assert "Termux:API" in result["detail"]
+
+
+def test_explicit_pcm_environment_diagnostics_disable_api_fallback(monkeypatch):
+    monkeypatch.setattr(vm, "_termux_voice_capture_available", unexpected_probe)
+    seen = []
+    def diagnose(*, api_fallback):
+        seen.append(api_fallback)
+        return {"available": False, "warnings": ["PortAudio input unavailable"], "notices": []}
+    monkeypatch.setattr(capture, "_sounddevice_environment", diagnose)
+    result = capture.detect_audio_environment({"capture_backend": "sounddevice"})
+    assert seen == [False] and result["warnings"] == ["PortAudio input unavailable"]
+
+
+def test_explicit_api_environment_preserves_missing_android_app_guidance(monkeypatch):
+    monkeypatch.setattr(vm, "_termux_microphone_command", lambda: "/prefix/bin/termux-microphone-record")
+    monkeypatch.setattr(vm, "_termux_api_app_installed", lambda: False)
+    monkeypatch.setattr(vm, "_import_audio", unexpected_probe)
+    result = capture.detect_audio_environment({"capture_backend": "termux-api"})
+    assert not result["available"]
+    assert vm._TERMUX_APP_MISSING_WARNING in result["warnings"]
+
+
+def test_invalid_configuration_is_a_diagnostic_without_attempting_installs(monkeypatch):
+    monkeypatch.setattr(vm, "_termux_voice_capture_available", unexpected_probe)
+    monkeypatch.setattr(vm, "_audio_available", unexpected_probe)
+    config = {"capture_backend": "invalid"}
+    assert "voice.capture_backend" in capture.capture_requirements(config)["detail"]
+    assert not capture.detect_audio_environment(config)["available"]
diff --git a/tests/tools/test_voice_mode_termux.py b/tests/tools/test_voice_mode_termux.py
new file mode 100644
index 00000000..094efc12
--- /dev/null
+++ b/tests/tools/test_voice_mode_termux.py
@@ -0,0 +1,218 @@
+"""Behavior contracts for Termux:API recording limits and asynchronous playback.
+
+The service is injected; these tests do not claim Android hardware permission,
+microphone quality, speaker output, or silence-detection coverage.
+"""
+
+import subprocess
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from tools import voice_mode as vm
+from tools.voice_mode_termux import TermuxMediaPlayback, recording_limit_seconds
+
+
+@pytest.mark.parametrize("value, expected", [
+    (None, 0), (0, 0), (-1, 0), (True, 0), ("12", 0),
+    (float("nan"), 0), (float("inf"), 0), (0.25, 0.25), (12, 12),
+    (3_000_000, 2_147_483),
+])
+def test_recording_limit_accepts_only_bounded_positive_numbers(value, expected):
+    assert recording_limit_seconds(value) == expected
+
+
+@pytest.fixture
+def recorder_service(monkeypatch, tmp_path):
+    calls, workers = [], []
+    monkeypatch.setattr(vm, "_termux_microphone_command", lambda: "termux-microphone-record")
+    monkeypatch.setattr(vm, "_termux_api_app_installed", lambda: True)
+    count = iter(range(100))
+    monkeypatch.setattr(vm, "_new_recording_path", lambda ext: str(tmp_path / f"take-{next(count)}.{ext}"))
+
+    def run(command, **kwargs):
+        calls.append(command)
+        if "-f" in command:
+            from pathlib import Path
+            path = Path(command[command.index("-f") + 1])
+            path.write_bytes(b"recorded AAC")
+            return subprocess.CompletedProcess(command, 0, f"Recording started: {path}\n", "")
+        return subprocess.CompletedProcess(command, 0, "", "")
+
+    def worker(target, **kwargs):
+        workers.append((target, kwargs["args"]))
+        return SimpleNamespace(start=lambda: None)
+
+    monkeypatch.setattr(vm, "_run_quiet", run)
+    monkeypatch.setattr("agent.memory_provider.spawn_context_thread", worker)
+    return calls, workers
+
+
+def test_recorder_supplies_native_cap_and_deadline_callback(recorder_service):
+    calls, workers = recorder_service
+    recorder = vm.TermuxAudioRecorder()
+    recorder._max_recording_seconds = 1.25
+    captured = []
+    recorder.start(on_silence_stop=lambda: captured.append(recorder.stop()))
+    recorder._start_time = time.monotonic() - 2
+    assert calls[0][calls[0].index("-l") + 1] == "2"
+    assert recorder.supports_silence_autostop is False
+    assert workers[0][1][1] == 1.25
+
+    cancel = recorder._duration_cancel
+    recorder._duration_elapsed(cancel, 0, workers[0][1][2])
+    assert len(captured) == 1 and captured[0].endswith(".aac")
+    assert not recorder.is_recording
+    assert cancel.is_set()
+    recorder._duration_elapsed(cancel, 0, workers[0][1][2])
+    assert len(captured) == 1
+
+
+def test_cancelling_a_take_invalidates_its_deadline(recorder_service):
+    calls, workers = recorder_service
+    recorder = vm.TermuxAudioRecorder()
+    recorder._max_recording_seconds = 5
+    fired = []
+    recorder.start(on_silence_stop=lambda: fired.append(True))
+    previous = recorder._duration_cancel
+    recorder.cancel()
+    recorder.start()
+    before = len(calls)
+    recorder._duration_elapsed(previous, 0, lambda: fired.append(True))
+    assert len(calls) == before
+    assert not fired
+    assert recorder.is_recording
+    recorder.cancel()
+
+
+def test_unlimited_recording_starts_no_deadline(recorder_service):
+    calls, workers = recorder_service
+    recorder = vm.TermuxAudioRecorder()
+    recorder.start()
+    assert calls[0][calls[0].index("-l") + 1] == "0"
+    assert workers == []
+    recorder.cancel()
+    before = len(calls)
+    recorder.cancel()
+    assert len(calls) == before  # cannot stop someone else's later recording
+
+
+def test_api_permission_error_is_not_success_even_with_zero_exit(monkeypatch, recorder_service):
+    monkeypatch.setattr(
+        vm, "_run_quiet",
+        lambda command, **kw: subprocess.CompletedProcess(command, 0, "Microphone permission denied", ""),
+    )
+    recorder = vm.TermuxAudioRecorder()
+    with pytest.raises(RuntimeError, match="Microphone permission denied"):
+        recorder.start()
+    assert not recorder.is_recording
+
+
+def test_player_waits_for_android_completion_and_uses_scrubbed_environment(tmp_path):
+    audio = tmp_path / "reply.aac"
+    audio.write_bytes(b"AAC")
+    calls = []
+    replies = iter([
+        "Now Playing: reply.aac",
+        "Status: Playing\nTrack: reply.aac\nCurrent Position: 00:00 / 00:01",
+        "No track currently!",
+    ])
+    clean_env = {"PATH": "test-path"}
+
+    def run(command, **kwargs):
+        calls.append(command)
+        assert kwargs["env"] is clean_env
+        assert kwargs["timeout"] == 10
+        return subprocess.CompletedProcess(command, 0, next(replies), "")
+
+    player = TermuxMediaPlayback("termux-media-player", str(audio), clean_env, run=run)
+    # No real sleep is needed to test the service's status transition.
+    player._cancel = SimpleNamespace(is_set=lambda: False, wait=lambda timeout: False)
+    assert player.wait()
+    assert [command[1] for command in calls] == ["play", "info", "info"]
+    assert player.poll() == 0
+
+
+def test_player_interruption_stops_only_its_own_track(tmp_path):
+    audio = tmp_path / "reply.aac"
+    calls = []
+
+    def run(command, **kwargs):
+        calls.append(command[1])
+        if command[1] == "play":
+            player.terminate()
+            output = "Now Playing: reply.aac"
+        elif command[1] == "info":
+            output = "Status: Playing\nTrack: reply.aac"
+        else:
+            output = "Stopped playback"
+        return subprocess.CompletedProcess(command, 0, output, "")
+
+    player = TermuxMediaPlayback("termux-media-player", str(audio), {}, run=run)
+    assert player.wait()
+    assert calls == ["play", "info", "stop"]
+
+
+def test_player_does_not_stop_another_clients_replacement_track(tmp_path):
+    calls = []
+
+    def run(command, **kwargs):
+        calls.append(command[1])
+        if command[1] == "play":
+            player.terminate()
+            output = "Now Playing: reply.aac"
+        else:
+            output = "Status: Playing\nTrack: music.mp3"
+        return subprocess.CompletedProcess(command, 0, output, "")
+
+    player = TermuxMediaPlayback("termux-media-player", str(tmp_path / "reply.aac"), {}, run=run)
+    assert player.wait()
+    assert calls == ["play", "info"]
+
+
+def test_player_preserves_zero_exit_service_error(tmp_path, caplog):
+    def run(command, **kwargs):
+        return subprocess.CompletedProcess(command, 0, "Permission denied by Android", "")
+
+    player = TermuxMediaPlayback("termux-media-player", str(tmp_path / "reply.aac"), {}, run=run)
+    assert player.wait() is False
+    assert "Permission denied by Android" in caplog.text
+    assert player.poll() == 1
+
+
+def test_interrupting_api_player_does_not_enable_audio_extra(monkeypatch, tmp_path):
+    player = TermuxMediaPlayback("termux-media-player", str(tmp_path / "reply.aac"), {})
+    monkeypatch.setattr(vm, "_active_playback", player)
+
+    def unexpected_import():
+        pytest.fail("Stopping an API player must not provision sounddevice/numpy")
+
+    monkeypatch.setattr(vm, "_import_audio", unexpected_import)
+    vm.stop_playback()
+    assert player._cancel.is_set()
+
+def test_api_player_entry_point_scrubs_credentials(monkeypatch, tmp_path):
+    from hermes_platform.resolver import Candidate, Resolution
+    from tools import voice_mode_termux
+
+    captured, active = {}, []
+    monkeypatch.setenv("OPENAI_API_KEY", "test-secret")
+    monkeypatch.setenv("TELEGRAM_BOT_TOKEN", "test-secret")
+    monkeypatch.setattr(
+        "hermes_platform.resolver.locate_command",
+        lambda name: Resolution("path_executable", (Candidate("termux-media-player", "PATH", True),)),
+    )
+
+    class Player:
+        def __init__(self, command, path, env):
+            captured["env"] = env
+
+        def wait(self):
+            return True
+
+    monkeypatch.setattr(voice_mode_termux, "TermuxMediaPlayback", Player)
+    assert voice_mode_termux.play_termux_audio(str(tmp_path / "reply.aac"), active.append)
+    assert active[-1] is None
+    assert "OPENAI_API_KEY" not in captured["env"]
+    assert "TELEGRAM_BOT_TOKEN" not in captured["env"]
