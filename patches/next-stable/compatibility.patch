new file mode 100644
index 00000000..bd98c2b1
--- /dev/null
+++ b/scripts/termux/selection_receipt.py
@@ -0,0 +1,69 @@
+"""Transfer a verified native environment selection into cross-host packaging."""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import re
+
+from scripts.termux.feature_profile import BUNDLED_EXTRAS
+
+TARGET = "linux-arm64-bionic"
+
+
+def _digest(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def write_selection(root: Path, requirements: Path) -> Path:
+    """Called only after the real Bionic PM installation and dependency check."""
+    from pm.packages import Venv
+    from pm.bundled_wheels import write_catalog
+    from pm.store import current_target
+
+    target = current_target()
+    if target != TARGET:
+        raise ValueError(f"Termux selection must be recorded on {TARGET}, got {target}")
+    extras = list(BUNDLED_EXTRAS)
+    descriptor = write_catalog(root, wheelhouse=root / "wheelhouse",
+                               lock_paths=(root / "app/uv.lock", root / "app/pm/uv.lock"))
+    receipt = {
+        "schema": 1,
+        "target": target,
+        "extras": extras,
+        "stamp": Venv(root / "app").expected_stamp(
+            extras, plugin_dirs=[], bundled_wheels_sha256=descriptor["sha256"],
+        ),
+        "bundled_wheels": descriptor,
+        "uv_lock_sha256": _digest(root / "app/uv.lock"),
+        "pm_lock_sha256": _digest(root / "app/pm/lock.json"),
+        "requirements_sha256": _digest(requirements),
+    }
+    destination = root / "venv-selection.json"
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    destination.write_text(json.dumps(receipt, indent=2) + "\n", encoding="utf-8")
+    return destination
+
+
+def read_selection(root: Path, receipt: Path, requirements: Path) -> dict:
+    """Refuse a stale receipt when any actual bundle input has changed."""
+    data = json.loads(receipt.read_text(encoding="utf-8-sig"))
+    if (data.get("schema") != 1 or data.get("target") != TARGET
+            or data.get("extras") != list(BUNDLED_EXTRAS)
+            or not isinstance(data.get("stamp"), str)
+            or re.fullmatch(r"[0-9a-f]{64}", data["stamp"]) is None):
+        raise ValueError("invalid native Termux environment selection")
+    descriptor = data.get("bundled_wheels")
+    if (not isinstance(descriptor, dict) or set(descriptor) != {"path", "sha256"}
+            or descriptor["path"] != "bundled-wheels.json"
+            or not isinstance(descriptor["sha256"], str)
+            or re.fullmatch(r"[0-9a-f]{64}", descriptor["sha256"]) is None):
+        raise ValueError("invalid native bundled wheel identity")
+    for field, source in (
+        ("uv_lock_sha256", root / "app/uv.lock"),
+        ("pm_lock_sha256", root / "app/pm/lock.json"),
+        ("requirements_sha256", requirements),
+    ):
+        if data.get(field) != _digest(source):
+            raise ValueError(f"native Termux selection no longer matches {source.name}")
+    return data
