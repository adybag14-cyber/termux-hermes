+"""Cold-cache bundle extension must reuse native bytes without changing locked sources."""
+from __future__ import annotations
+
+from dataclasses import replace
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import shutil
+import sys
+import tarfile
+from types import SimpleNamespace
+
+import pytest
+from packaging.markers import default_environment
+
+from pm.bundled_wheels import interpreter_markers, load_catalog, write_catalog
+from pm.environment import PythonEnvironment
+from pm.package import InstallError
+from tests.pm._fixtures import _run, _wheel, served as served  # noqa: PLC0414
+
+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _native_sdist(directory: Path) -> Path:
+    """A metadata-valid source that cannot build on this simulated native target."""
+    files = {
+        "pyproject.toml": (
+            '[project]\nname="native-fixture"\nversion="1.0"\nrequires-python=">=3.11"\n'
+            '[build-system]\nrequires=[]\nbuild-backend="backend"\nbackend-path=["."]\n'
+        ),
+        "PKG-INFO": "Metadata-Version: 2.2\nName: native-fixture\nVersion: 1.0\nRequires-Python: >=3.11\n",
+        "backend.py": (
+            'def build_wheel(*args, **kwargs):\n'
+            '    raise RuntimeError("native compiler is deliberately unavailable")\n'
+        ),
+    }
+    path = directory / "native_fixture-1.0.tar.gz"
+    with tarfile.open(path, "w:gz") as archive:
+        for name, text in files.items():
+            body = text.encode()
+            info = tarfile.TarInfo(f"native_fixture-1.0/{name}")
+            info.size = len(body)
+            archive.addfile(info, io.BytesIO(body))
+    return path
+
+
+def _index(docroot: Path, artifact: Path, name: str) -> None:
+    entry = docroot / "simple" / name.replace("_", "-")
+    entry.mkdir(parents=True)
+    (entry / "index.html").write_text(
+        f'<a href="../../files/{artifact.name}#sha256={_sha(artifact)}">{artifact.name}</a>\n',
+        encoding="utf-8",
+    )
+
+
+@pytest.fixture
+def native_project(served, tmp_path, monkeypatch):
+    import pm.paths
+
+    docroot, url = served
+    artifacts = docroot / "files"
+    artifacts.mkdir()
+    original = _native_sdist(artifacts)
+    _index(docroot, original, "native_fixture")
+    names = ("optional_sdk", "member_fixture", "chosen_fixture", "other_fixture",
+             "optin_fixture", "default_fixture", "group_fixture")
+    wheels = {name: _wheel(artifacts, name) for name in names}
+    for name, artifact in wheels.items():
+        _index(docroot, artifact, name)
+    source = tmp_path / "generated workspace"
+    source.mkdir()
+    (source / "pyproject.toml").write_text(
+        '[project]\nname="fixture-root"\nversion="1.0"\nrequires-python=">=3.11"\n'
+        'dependencies=["native-fixture==1.0"]\n'
+        '[project.optional-dependencies]\nsdk=["optional-sdk==1.0"]\n'
+        'chosen=["chosen-fixture==1.0"]\nother=["other-fixture==1.0"]\n'
+        'manual=["optin-fixture==1.0"]\n'
+        '[dependency-groups]\ndev=["default-fixture==1.0"]\nselected=["group-fixture==1.0"]\n'
+        '[tool.uv]\npackage=false\n'
+        f'index-url={json.dumps(url + "/simple")}\n'
+        '[tool.uv.workspace]\nmembers=["member"]\n'
+        '[tool.hermes]\nopt-in-extras=["manual"]\n', encoding="utf-8",
+    )
+    member = source / "member"
+    member.mkdir()
+    (member / "pyproject.toml").write_text(
+        '[project]\nname="fixture-plugin"\nversion="1.0"\nrequires-python=">=3.11"\n'
+        'dependencies=["member-fixture==1.0"]\n[tool.uv]\npackage=false\n', encoding="utf-8",
+    )
+    uv = shutil.which("uv")
+    assert uv, "bundled native wheel behavior requires real uv"
+    env = {k: v for k, v in os.environ.items() if not k.startswith(("UV_", "PYTHON")) and k != "VIRTUAL_ENV"}
+    engine = PythonEnvironment(uv=Path(uv), python=Path(sys.executable),
+                               destination=tmp_path / "generation" / "venv",
+                               cache=tmp_path / "lock-cache", env=env)
+    engine.lock(source, timeout=60)
+    lock_bytes = (source / "uv.lock").read_bytes()
+    payload = tmp_path / "sealed payload"
+    (payload / "app").mkdir(parents=True)
+    bundled = payload / "wheelhouse"
+    bundled.mkdir()
+    _wheel(bundled, "native_fixture")
+    for name, wheel in wheels.items():
+        if name != "optional_sdk":
+            shutil.copy2(wheel, bundled / wheel.name)
+    descriptor = write_catalog(payload, wheelhouse=bundled, lock_paths=(source / "uv.lock",))
+    (payload / "manifest.json").write_text(json.dumps({"repo": "app", "bundled_wheels": descriptor}), encoding="utf-8")
+    monkeypatch.setattr(pm.paths, "repo_root", lambda: payload / "app")
+    # No resolver/build cache from the lock operation survives into installation.
+    shutil.rmtree(engine.cache)
+    yield SimpleNamespace(source=source, payload=payload, engine=replace(engine, cache=tmp_path / "cold-cache"),
+                          lock_bytes=lock_bytes, names=("native_fixture", *names), original=original)
+
+
+@pytest.mark.parametrize("selection, expected", [
+    ({"extras": ["sdk"], "no_default_groups": True},
+     {"native_fixture", "member_fixture", "optional_sdk"}),
+    ({"all_extras": True, "groups": ["selected"]},
+     {"native_fixture", "member_fixture", "optional_sdk", "chosen_fixture", "other_fixture",
+      "default_fixture", "group_fixture"}),
+    ({"extras": ["manual"], "groups": ["selected"], "no_default_groups": True},
+     {"native_fixture", "member_fixture", "optin_fixture", "group_fixture"}),
+])
+def test_cold_cache_extension_preserves_exact_native_wheel_and_actual_selection(native_project, selection, expected):
+    case = native_project
+    assert not case.engine.cache.exists()
+    case.engine.create()
+    case.engine.sync(case.source, **selection)
+    script = (
+        "import importlib.util, importlib.metadata, json; "
+        f"names = {case.names!r}; "
+        "print(json.dumps({n: importlib.metadata.version(n) for n in names "
+        "if importlib.util.find_spec(n) is not None}))"
+    )
+    result = json.loads(_run([str(case.engine.executable), "-I", "-c", script],
+                             cwd=case.source, env=dict(case.engine.env)))
+    assert result == {name: "1.0" for name in expected}
+    assert (case.source / "uv.lock").read_bytes() == case.lock_bytes
+    # A later sync removes excluded installed wheels before restoring them too.
+    case.engine.sync(case.source, **selection)
+    assert json.loads(_run([str(case.engine.executable), "-I", "-c", script],
+                           cwd=case.source, env=dict(case.engine.env))) == result
+
+
+def test_missing_catalog_keeps_the_real_native_build_failure(native_project):
+    case = native_project
+    (case.payload / "manifest.json").write_text('{"repo":"app"}', encoding="utf-8")
+    case.engine.create()
+    with pytest.raises(InstallError, match="native compiler is deliberately unavailable"):
+        case.engine.sync(case.source, extras=["sdk"], no_default_groups=True)
+    assert (case.source / "uv.lock").read_bytes() == case.lock_bytes
+
+
+def _write_lock(path: Path, package: dict) -> None:
+    def inline(values):
+        return "{ " + ", ".join(f"{k} = {json.dumps(v)}" for k, v in values.items()) + " }"
+    lines = ["version = 1", "[[package]]", f'name = {json.dumps(package["name"])}',
+             f'version = {json.dumps(package["version"])}', "source = " + inline(package["source"])]
+    if "sdist" in package:
+        lines.append("sdist = " + inline(package["sdist"]))
+    if "wheels" in package:
+        lines.append("wheels = [" + ", ".join(inline(v) for v in package["wheels"]) + "]")
+    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+
+@pytest.fixture
+def catalog_fixture(tmp_path, monkeypatch):
+    import pm.paths
+
+    payload = tmp_path / "sealed"
+    root = payload / "app"
+    root.mkdir(parents=True)
+    wheelhouse = payload / "wheelhouse"
+    wheelhouse.mkdir()
+    wheel = _wheel(wheelhouse, "native_fixture")
+    lock = root / "uv.lock"
+    monkeypatch.setattr(pm.paths, "repo_root", lambda: root)
+
+    def prepare(kind="sdist"):
+        package = {"name": "native-fixture", "version": "1.0",
+                   "source": {"registry": "https://pypi.org/simple"},
+                   "sdist": {"url": "https://files.example.test/native_fixture-1.0.tar.gz",
+                             "hash": "sha256:" + "a" * 64}}
+        if kind == "wheel":
+            package["wheels"] = [{"url": "https://files.example.test/" + wheel.name, "hash": "sha256:" + _sha(wheel)}]
+        if kind == "git":
+            package.pop("sdist")
+            package["source"] = {"git": "https://example.test/native.git?rev=" + "a" * 40 + "#" + "a" * 40}
+        _write_lock(lock, package)
+        descriptor = write_catalog(payload, wheelhouse=wheelhouse, lock_paths=(lock,))
+        (payload / "manifest.json").write_text(json.dumps({"repo": "app", "bundled_wheels": descriptor}), encoding="utf-8")
+        return SimpleNamespace(payload=payload, root=root, wheel=wheel, lock=lock,
+                               package=package, catalog=load_catalog())
+    return prepare
+
+
+@pytest.mark.parametrize("change", ["version", "registry", "sdist-url", "sdist-hash", "direct-url"])
+def test_same_name_does_not_reuse_a_different_locked_source_or_version(catalog_fixture, change):
+    case = catalog_fixture()
+    assert [w.name for w in case.catalog.select("native-fixture==1.0", case.lock, default_environment())] == ["native-fixture"]
+    requirement = "native-fixture==1.0"
+    if change == "version":
+        case.package["version"] = "1.1"
+        requirement = "native-fixture==1.1"
+    elif change == "registry":
+        case.package["source"]["registry"] = "https://other.example.test/simple"
+    elif change == "sdist-url":
+        case.package["sdist"]["url"] = "https://other.example.test/native_fixture-1.0.tar.gz"
+    elif change == "sdist-hash":
+        case.package["sdist"]["hash"] = "sha256:" + "b" * 64
+    else:
+        case.package["source"] = {"url": "https://other.example.test/native_fixture-1.0.tar.gz"}
+        requirement = "native-fixture @ https://other.example.test/native_fixture-1.0.tar.gz"
+    _write_lock(case.lock, case.package)
+    assert case.catalog.select(requirement, case.lock, default_environment()) == []
+
+
+def test_git_wheel_requires_the_same_full_commit(catalog_fixture):
+    case = catalog_fixture("git")
+    requirement = "native-fixture @ git+https://example.test/native.git@" + "a" * 40
+    assert [w.name for w in case.catalog.select(requirement, case.lock, default_environment())] == ["native-fixture"]
+    case.package["source"]["git"] = case.package["source"]["git"].replace("a" * 40, "b" * 40)
+    _write_lock(case.lock, case.package)
+    assert case.catalog.select(requirement.replace("a" * 40, "b" * 40), case.lock, default_environment()) == []
+
+
+def test_registry_wheel_does_not_require_a_missing_sdist(catalog_fixture):
+    case = catalog_fixture("wheel")
+    case.package.pop("sdist")
+    _write_lock(case.lock, case.package)
+    descriptor = write_catalog(case.payload, wheelhouse=case.payload / "wheelhouse", lock_paths=(case.lock,))
+    (case.payload / "manifest.json").write_text(json.dumps({"repo": "app", "bundled_wheels": descriptor}), encoding="utf-8")
+    assert [w.name for w in load_catalog().select("native-fixture==1.0", case.lock, default_environment())] == ["native-fixture"]
+
+
+@pytest.mark.parametrize("damage", ["catalog-bytes", "wheel-bytes", "path-traversal", "duplicate-row"])
+def test_damaged_or_escaping_catalog_is_rejected(catalog_fixture, damage):
+    case = catalog_fixture()
+    path = case.payload / "bundled-wheels.json"
+    if damage == "catalog-bytes":
+        path.write_bytes(path.read_bytes() + b" ")
+        with pytest.raises(InstallError, match="catalog SHA-256 mismatch"):
+            load_catalog()
+    elif damage == "wheel-bytes":
+        case.wheel.write_bytes(case.wheel.read_bytes() + b"changed")
+        with pytest.raises(ValueError, match="SHA-256 or size mismatch"):
+            case.catalog.select("native-fixture==1.0", case.lock, default_environment())
+    else:
+        data = json.loads(path.read_text())
+        if damage == "path-traversal":
+            data["wheels"][0]["file"] = "../foreign.whl"
+        else:
+            data["wheels"].append(data["wheels"][0])
+        path.write_text(json.dumps(data), encoding="utf-8")
+        (case.payload / "manifest.json").write_text(json.dumps({
+            "repo": "app", "bundled_wheels": {"path": path.name, "sha256": _sha(path)},
+        }), encoding="utf-8")
+        with pytest.raises(InstallError, match="wheelhouse filename|Duplicate bundled wheel identity"):
+            load_catalog()
+
