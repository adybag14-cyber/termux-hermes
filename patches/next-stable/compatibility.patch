new file mode 100644
index 00000000..7a480957
--- /dev/null
+++ b/scripts/termux/nemo_source.py
@@ -0,0 +1,83 @@
+"""Use the reviewed NeMo Relay sdist with Termux's native protobuf compiler.
+
+The vendor crate has no Android executable. Only the build script changes;
+the source archive, Cargo.lock, protobuf schema and runtime code stay pinned.
+"""
+from __future__ import annotations
+
+import hashlib
+import os
+from pathlib import Path
+import re
+import subprocess
+from typing import Callable
+from urllib.parse import urlsplit, urlunsplit
+import urllib.request
+
+SDIST_SHA256 = "d3382e826d3d65551f3a307128c15116057fd7f45277f8a8d0cb51f8aca3ed68"
+SDIST_SIZE = 1922175
+WORKER_BUILD_SHA256 = "5051da22939be4607b1b23d067799d54632f935119bf9a09bb3ff39ae64a4c51"
+_WORKER_BUILD = Path("crates/worker-proto/build.rs")
+
+
+def patch_worker_proto(source: Path) -> None:
+    """Fail on an unreviewed build script instead of guessing at a new release."""
+    script = source / _WORKER_BUILD
+    original = script.read_bytes()
+    if hashlib.sha256(original).hexdigest() != WORKER_BUILD_SHA256:
+        raise ValueError("Unreviewed NeMo Relay worker-proto build script")
+    old = b"    prost.protoc_executable(protoc_bin_vendored::protoc_bin_path()?);\n"
+    new = (
+        b'    println!("cargo:rerun-if-env-changed=PROTOC");\n'
+        b'    let protoc = std::env::var_os("PROTOC")\n'
+        b'        .ok_or("Termux build requires validated PROTOC")?;\n'
+        b"    prost.protoc_executable(std::path::PathBuf::from(protoc));\n"
+    )
+    script.write_bytes(original.replace(old, new, 1))
+
+
+def _validated_protoc() -> Path:
+    declared = os.environ.get("PROTOC", "")
+    compiler = Path(declared)
+    if not declared or not compiler.is_absolute() or not compiler.is_file():
+        raise ValueError("NeMo Relay requires an absolute existing PROTOC executable")
+    compiler = compiler.resolve()
+    result = subprocess.run(
+        [str(compiler), "--version"], check=True, capture_output=True,
+        text=True, encoding="utf-8", timeout=15,
+    )
+    version = re.fullmatch(r"libprotoc (\d+)\.(\d+)(?:\.\d+)?", result.stdout.strip())
+    if version is None or tuple(map(int, version.groups())) < (3, 15):
+        raise ValueError("NeMo Relay requires a working protobuf compiler >= 3.15")
+    return compiler
+
+
+def prepare_nemo_source(
+    requirement: str, work: Path, *, extract: Callable[[Path, Path], Path],
+) -> tuple[Path, dict[str, str]]:
+    """Download verified bytes before pip can run the unpatched build backend.
+
+    The requirement comes from locked_sources.native_requirement. The extra
+    hash guard makes a future lock update require review of this source patch.
+    The extract callback is the wheel builder's existing safe archive extractor.
+    """
+    name, separator, artifact = requirement.partition(" @ ")
+    parsed = urlsplit(artifact)
+    if (
+        name != "nemo-relay" or not separator or parsed.scheme != "https"
+        or not parsed.netloc or parsed.fragment != "sha256=" + SDIST_SHA256
+    ):
+        raise ValueError("NeMo Relay source must match the reviewed locked sdist")
+    compiler = _validated_protoc()
+    url = urlunsplit((parsed.scheme, parsed.netloc, parsed.path, parsed.query, ""))
+    with urllib.request.urlopen(url, timeout=60) as response:
+        data = response.read(SDIST_SIZE + 1)
+    if len(data) != SDIST_SIZE or hashlib.sha256(data).hexdigest() != SDIST_SHA256:
+        raise ValueError("NeMo Relay source hash or size differs from the reviewed lock")
+    work.mkdir(parents=True, exist_ok=True)
+    archive = work / "nemo_relay-0.10.0.tar.gz"
+    with archive.open("xb") as stream:
+        stream.write(data)
+    source = extract(archive, work / "source")
+    patch_worker_proto(source)
+    return source, {"PROTOC": str(compiler)}
