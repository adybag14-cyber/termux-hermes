diff --git a/hermes_cli/gateway_runit.py b/hermes_cli/gateway_runit.py
new file mode 100644
index 00000000..3237a8a6
--- /dev/null
+++ b/hermes_cli/gateway_runit.py
@@ -0,0 +1,308 @@
+"""Per-home Termux runit services, sharing the native termux-services daemon.
+
+Only marker-owned service directories are changed. The daemon is started when
+needed and is never stopped: it may supervise unrelated Termux services.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import tempfile
+import time
+
+from hermes_platform.resolver.termux_services import TermuxServices, resolve_termux_services
+
+MARKER = "hermes-service.json"
+
+
+class RunitServiceError(RuntimeError):
+    """A Termux service operation failed with actionable user-facing detail."""
+
+
+def _gw():
+    from hermes_cli import gateway
+    return gateway
+
+
+def service_name(home: Path) -> str:
+    identity = str(Path(home).resolve()).encode("utf-8")
+    return "hermes-gateway-" + hashlib.sha256(identity).hexdigest()[:16]
+
+
+@dataclass(frozen=True)
+class ServiceState:
+    installed: bool
+    supervised: bool = False
+    pid: int | None = None
+    detail: str = ""
+
+    @property
+    def running(self) -> bool:
+        return self.pid is not None
+
+
+class RunitService:
+    def __init__(self, tools: TermuxServices, home: Path, root: Path, *, timeout: int = 30):
+        self.tools, self.home, self.root = tools, Path(home).resolve(), Path(root).resolve()
+        self.path = tools.services / service_name(self.home)
+        self.timeout = max(7, int(timeout))
+
+    @property
+    def identity(self) -> dict:
+        return {"schema": 1, "home": str(self.home), "root": str(self.root)}
+
+    def _owned(self) -> bool:
+        if not self.path.exists() and not self.path.is_symlink():
+            return False
+        try:
+            marker = self.path / MARKER
+            if self.path.is_symlink() or not self.path.is_dir() or marker.is_symlink():
+                raise ValueError("service directory or marker is a symlink")
+            if json.loads(marker.read_text(encoding="utf-8")) != self.identity:
+                raise ValueError("service identity does not match this installation and home")
+            for name in ("run", "finish", "down"):
+                path = self.path / name
+                if path.is_symlink():
+                    raise ValueError(f"{name} is a symlink")
+            if not (self.path / "run").is_file():
+                raise ValueError("service run script is missing")
+        except (OSError, ValueError) as exc:
+            raise RunitServiceError(f"Refusing foreign or damaged service {self.path}: {exc}") from exc
+        return True
+
+    def _run(self, args: list[str], *, timeout: int = 7):
+        try:
+            return subprocess.run(args, env=self.tools.environment(), capture_output=True,
+                                  text=True, encoding="utf-8", errors="replace",
+                                  timeout=timeout, check=False)
+        except (OSError, subprocess.TimeoutExpired) as exc:
+            raise RunitServiceError(f"Termux runit command failed: {exc}") from exc
+
+    def state(self) -> ServiceState:
+        if not self._owned():
+            return ServiceState(False)
+        result = self._run([str(self.tools.sv), "status", str(self.path)])
+        detail = (result.stdout + result.stderr).strip()
+        match = re.search(r"^run: .*: \(pid ([1-9][0-9]*)\)", result.stdout, re.MULTILINE)
+        return ServiceState(True, result.returncode == 0,
+                            int(match.group(1)) if match and result.returncode == 0 else None,
+                            detail)
+
+    def _ensure_supervised(self) -> None:
+        if self.state().supervised:
+            return
+        # service-daemon may return 1 when an existing daemon owns its PID file;
+        # the authoritative gate is whether sv can talk to THIS service.
+        self._run([str(self.tools.daemon), "start"], timeout=10)
+        deadline = time.monotonic() + 12
+        while not self.state().supervised:
+            if time.monotonic() >= deadline:
+                raise RunitServiceError(
+                    "Termux runit did not supervise this service. Restart your Termux shell, "
+                    "then retry hermes gateway start; inspect the service-daemon if it persists.")
+            time.sleep(0.1)
+
+    def _control(self, verb: str) -> None:
+        self._owned()
+        result = self._run([str(self.tools.sv), "-w", str(self.timeout), verb, str(self.path)],
+                           timeout=self.timeout + 5)
+        if result.returncode:
+            detail = (result.stdout + result.stderr).strip()
+            raise RunitServiceError(f"Termux runit could not {verb} {self.path.name}: {detail}")
+
+    def install(self, command: list[str], *, start_now: bool = True,
+                start_on_login: bool = True, force: bool = False) -> None:
+        exists = self._owned()
+        if exists and not force:
+            return
+        if not command or any(not isinstance(arg, str) or "\0" in arg for arg in command):
+            raise RunitServiceError("Gateway service command is empty or invalid")
+        if not self.home.is_dir():
+            raise RunitServiceError(f"Gateway home does not exist: {self.home}")
+        log = self.home / "logs" / "gateway-runit.log"
+        log.parent.mkdir(parents=True, exist_ok=True)
+        run = (
+            f"#!{self.tools.shell}\nset -eu\numask 077\n"
+            f"export HERMES_HOME={shlex.quote(str(self.home))}\n"
+            "export HERMES_SUPERVISED_CHILD=1\n"
+            f"cd {shlex.quote(str(self.home))}\n"
+            f"exec >>{shlex.quote(str(log))} 2>&1\n"
+            f"exec {shlex.join(command)}\n"
+        )
+        # Configuration exit 78 is terminal, as on the existing systemd backend.
+        finish = (
+            f"#!{self.tools.shell}\n"
+            f'if [ "$1" = 78 ]; then exec {shlex.quote(str(self.tools.sv))} '
+            f"down {shlex.quote(str(self.path))}; fi\n"
+        )
+        self.tools.services.mkdir(parents=True, exist_ok=True)
+        if exists:
+            (self.path / 'down').touch()
+            self.stop()
+            for name, content in (("run", run), ("finish", finish)):
+                with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", newline="\n",
+                                                 prefix="."+name+".", dir=self.path, delete=False) as staged:
+                    staged.write(content)
+                    staging = Path(staged.name)
+                staging.chmod(0o700)
+                os.replace(staging, self.path / name)
+        else:
+            with tempfile.TemporaryDirectory(prefix=".hermes-gateway-", dir=self.tools.services) as temp:
+                staging = Path(temp) / "service"
+                staging.mkdir(mode=0o700)
+                for name, content in (("run", run), ("finish", finish)):
+                    target = staging / name
+                    target.write_text(content, encoding="utf-8", newline="\n")
+                    target.chmod(0o700)
+                (staging / MARKER).write_text(json.dumps(self.identity) + "\n", encoding="utf-8")
+                (staging / "down").touch()
+                os.rename(staging, self.path)
+        # Publish disabled, wait until runsv has observed that state, and then
+        # apply the next-login policy. Removing down now does not change runsv's
+        # current want-down state, so --no-start-now does not race an auto-start.
+        (self.path / "down").touch()
+        self._ensure_supervised()
+        self._control("stop")
+        if start_on_login:
+            (self.path / "down").unlink()
+        if start_now:
+            self.start()
+
+    def start(self) -> None:
+        if not self._owned():
+            raise RunitServiceError("Gateway runit service is not installed; run hermes gateway install")
+        self._ensure_supervised()
+        self._control("start")
+
+    def stop(self) -> None:
+        if not self._owned():
+            raise RunitServiceError("Gateway runit service is not installed")
+        if self.state().supervised:
+            self._control("stop")
+
+    def restart(self) -> None:
+        if not self._owned():
+            raise RunitServiceError("Gateway runit service is not installed")
+        self._ensure_supervised()
+        self._control("restart")
+
+    def uninstall(self) -> None:
+        if not self._owned():
+            return
+        (self.path / "down").touch()
+        self.stop()
+        # A dot-directory is invisible to runsvdir. Unpublish before asking
+        # this one runsv to exit so the shared daemon cannot respawn it.
+        old = self.path
+        with tempfile.TemporaryDirectory(prefix=".hermes-gateway-remove-", dir=old.parent) as temp:
+            removed = Path(temp) / "service"
+            os.rename(old, removed)
+            self.path = removed
+            try:
+                if self.state().supervised:
+                    self._control("shutdown")
+            except BaseException:
+                os.rename(removed, old)
+                raise
+            finally:
+                self.path = old
+
+
+def available() -> bool:
+    return _gw().is_termux() and resolve_termux_services() is not None
+
+
+def current() -> RunitService:
+    tools = resolve_termux_services()
+    if not _gw().is_termux() or tools is None:
+        raise RunitServiceError(
+            "Termux runit is unavailable. Install it with pkg install termux-services, "
+            "restart your shell, then retry. Manual use remains hermes gateway run.")
+    gw = _gw()
+    budget = gw.resolve_systemd_timeout_stop_sec(gw._get_restart_drain_timeout(),
+                                                 gw._get_cron_drain_timeout())
+    return RunitService(tools, gw.get_hermes_home(), gw.PROJECT_ROOT, timeout=budget)
+
+
+def is_installed() -> bool:
+    return available() and current()._owned()
+
+
+def require_user_scope(system=False, run_as_user=None) -> None:
+    if system or run_as_user:
+        raise RunitServiceError("Termux runit runs as the Termux app user; --system/--run-as-user are unavailable")
+
+
+def command_for_service() -> list[str]:
+    from pm.environments import payload_command_dir, cli_command_name
+    from hermes_cli._launchers import installation_command
+    gw = _gw()
+    args = ["gateway", "run", "--external-supervisor"]
+    # Sealed APT launchers own Bionic library scope and PM generation selection.
+    # Never mint a source launcher inside the package or pin a venv generation.
+    directory = payload_command_dir(gw.PROJECT_ROOT)
+    if directory is not None:
+        command = directory / cli_command_name(gw.PROJECT_ROOT)
+        if not command.is_file():
+            raise RunitServiceError(f"Bundled Hermes launcher is missing: {command}")
+        return [str(command), *args]
+    if gw._is_apt_termux_install():
+        raise RunitServiceError("Sealed Termux package has no valid launcher; reinstall it with APT")
+    gw._prepare_service_launcher()
+    return installation_command(gw.PROJECT_ROOT, args, python=gw.get_python_path(),
+                                home=gw.get_hermes_home())
+
+
+def install_from_cli(args) -> None:
+    require_user_scope(getattr(args, "system", False), getattr(args, "run_as_user", None))
+    service = current()
+    service.install(command_for_service(), force=getattr(args, "force", False),
+                    start_now=getattr(args, "start_now", None) is not False,
+                    start_on_login=getattr(args, "start_on_login", None) is not False)
+    print(f"Gateway runit service installed: {service.path}")
+    print("Termux must remain running; Android force-stop stops its services.")
+
+
+def dispatch(verb: str, *, system=False) -> None:
+    require_user_scope(system)
+    service = current()
+    getattr(service, verb)()
+    print(f"Gateway runit service {verb}: {service.path.name}")
+
+
+def status(*, system=False) -> None:
+    require_user_scope(system)
+    service = current()
+    state = service.state()
+    print(f"Termux runit: {state.detail or 'service is not installed'}")
+    print(f"  Service: {service.path}")
+    print(f"  Log: {service.home / 'logs' / 'gateway-runit.log'}")
+    print("  Android force-stop stops Termux services.")
+
+
+def service_pids(*, all_profiles=False) -> set[int]:
+    if not available():
+        return set()
+    own = current()
+    if not all_profiles:
+        state = own.state()
+        return {state.pid} if state.pid is not None else set()
+    pids = set()
+    for path in own.tools.services.glob("hermes-gateway-*"):
+        try:
+            marker = json.loads((path / MARKER).read_text(encoding="utf-8"))
+            service = RunitService(own.tools, Path(marker["home"]), Path(marker["root"]))
+            if service.path != path:
+                continue
+            state = service.state()
+            if state.pid is not None:
+                pids.add(state.pid)
+        except (OSError, ValueError, KeyError, TypeError, RunitServiceError):
+            continue
+    return pids
