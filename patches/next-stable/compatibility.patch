@@ -0,0 +1,218 @@
+"""Behavior contracts for Termux:API recording limits and asynchronous playback.
+
+The service is injected; these tests do not claim Android hardware permission,
+microphone quality, speaker output, or silence-detection coverage.
+"""
+
+import subprocess
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from tools import voice_mode as vm
+from tools.voice_mode_termux import TermuxMediaPlayback, recording_limit_seconds
+
+
+@pytest.mark.parametrize("value, expected", [
+    (None, 0), (0, 0), (-1, 0), (True, 0), ("12", 0),
+    (float("nan"), 0), (float("inf"), 0), (0.25, 0.25), (12, 12),
+    (3_000_000, 2_147_483),
+])
+def test_recording_limit_accepts_only_bounded_positive_numbers(value, expected):
+    assert recording_limit_seconds(value) == expected
+
+
+@pytest.fixture
+def recorder_service(monkeypatch, tmp_path):
+    calls, workers = [], []
+    monkeypatch.setattr(vm, "_termux_microphone_command", lambda: "termux-microphone-record")
+    monkeypatch.setattr(vm, "_termux_api_app_installed", lambda: True)
+    count = iter(range(100))
+    monkeypatch.setattr(vm, "_new_recording_path", lambda ext: str(tmp_path / f"take-{next(count)}.{ext}"))
+
+    def run(command, **kwargs):
+        calls.append(command)
+        if "-f" in command:
+            from pathlib import Path
+            path = Path(command[command.index("-f") + 1])
+            path.write_bytes(b"recorded AAC")
+            return subprocess.CompletedProcess(command, 0, f"Recording started: {path}\n", "")
+        return subprocess.CompletedProcess(command, 0, "", "")
+
+    def worker(target, **kwargs):
+        workers.append((target, kwargs["args"]))
