+"""A rebuilt bundled wheel invalidates a previously reusable PM generation."""
+from pathlib import Path
+from types import SimpleNamespace
+
+from pm.packages import Venv
+
+
+def test_rebuilt_bundle_catalog_changes_environment_selection_stamp(monkeypatch):
+    project = Venv(Path(__file__).resolve().parents[2])
+    monkeypatch.setattr("pm.bundled_wheels.load_catalog", lambda: None)
+    legacy = project.expected_stamp(["termux"], plugin_dirs=[])
+    original = project.expected_stamp(["termux"], plugin_dirs=[], bundled_wheels_sha256="a" * 64)
+    rebuilt = project.expected_stamp(["termux"], plugin_dirs=[], bundled_wheels_sha256="b" * 64)
+    assert len({legacy, original, rebuilt}) == 3
+    monkeypatch.setattr("pm.bundled_wheels.load_catalog", lambda: SimpleNamespace(sha256="b" * 64))
+    assert project.expected_stamp(["termux"], plugin_dirs=[]) == rebuilt
