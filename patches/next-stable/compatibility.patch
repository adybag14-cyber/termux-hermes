+def test_cancelling_a_take_invalidates_its_deadline(recorder_service):
+    calls, workers = recorder_service
+    recorder = vm.TermuxAudioRecorder()
+    recorder._max_recording_seconds = 5
+    fired = []
+    recorder.start(on_silence_stop=lambda: fired.append(True))
+    previous = recorder._duration_cancel
+    recorder.cancel()
+    recorder.start()
+    before = len(calls)
+    recorder._duration_elapsed(previous, 0, lambda: fired.append(True))
+    assert len(calls) == before
+    assert not fired
