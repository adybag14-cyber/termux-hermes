+"""Source-built PM tools require the executing payload and exact build identity."""
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from pm import bundled_tools, paths, registry
+from pm.lock import Facts, Lockfile
+from pm.package import InstallError, Package
+from pm.store import current_target, tree_digest
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+@pytest.fixture
+def built(tmp_path, monkeypatch):
+    target = current_target()
+    payload = tmp_path / "payload"
+    repo = payload / "app"
+    (repo / "pm").mkdir(parents=True)
+    (payload / "tools").mkdir()
+    source = tmp_path / "source.json"
+    source.write_bytes(b'{"schema":1,"commit":"1111111111111111111111111111111111111111"}\n')
+
+    class FixtureTool(Package):
+        name = "fixture-source-tool"
+        source_built_receipts = {target: {"version": "1.0.0", "sha256": digest(source)}}
+        gaps = {target: "fixture has no remote artifact"}
+
+        def binary(self, entry, target):
+            return entry / ("tool.exe" if target.startswith("win32") else "tool")
+
+        def env(self, entry, target):
+            return {"PATH": [str(entry)]}
+
+    package = FixtureTool()
+    registry.get_package("cua-driver")  # Populate builtins before the fixture registration.
+    monkeypatch.setitem(registry._packages, package.name, package)
+    lock_path = repo / "pm/lock.json"
+    lock_path.write_text(json.dumps({"schema": 1, "packages": {
+        package.name: {"version": "1.0.0", "artifacts": {}},
+    }}), encoding="utf-8")
+    manifest = {"schema": 1, "target": target, "repo": "app", "venv": "venv",
+                "store": "tools", "runtime": {"commands": {"hermes": "bin/hermes"}}}
+    (payload / "manifest.json").write_text(json.dumps(manifest), encoding="utf-8")
+    monkeypatch.setattr(paths, "repo_root", lambda: repo)
+    monkeypatch.setattr(paths, "lockfile_path", lambda: lock_path)
+    monkeypatch.delenv("HERMES_RUNTIME_DIR", raising=False)
+    binary = Path(sys.executable).resolve()
+    staged = bundled_tools.stage_source_built_tool(
+        payload, name=package.name, target=target, binary=binary,
+        binary_sha256=digest(binary), source_receipt=source,
+    )
+    return SimpleNamespace(payload=payload, repo=repo, package=package, target=target,
+                           staged=staged, lock_path=lock_path,
+                           entry=payload / staged["tool"]["entry"])
+
+
+def rewrite_catalog(built, change):
+    catalog = built.payload / bundled_tools.CATALOG_NAME
+    document = json.loads(catalog.read_bytes())
+    change(document)
+    catalog.write_text(json.dumps(document), encoding="utf-8")
+    manifest_path = built.payload / "manifest.json"
+    manifest = json.loads(manifest_path.read_bytes())
+    manifest["bundled_tools"]["sha256"] = digest(catalog)
+    manifest_path.write_text(json.dumps(manifest), encoding="utf-8")
+
+
+def test_existing_pm_interfaces_select_exact_baked_bytes_without_download(built, monkeypatch):
+    import importlib
+    install = importlib.import_module("pm.install")
+    monkeypatch.setattr(install, "_install", lambda *a, **kw: pytest.fail("unexpected acquisition"))
+
+    selected = install.installed_package(built.package.name)
+    assert selected.path == built.entry
+    assert selected.binary == built.package.binary(built.entry, built.target)
+    assert selected.version == "1.0.0"
+    assert install.is_installed(built.package.name)
+    runner = install.ensure(built.package.name, explicit=True, base_env={"PATH": "original"})
+    assert runner.env["PATH"].split(__import__("os").pathsep)[0] == str(built.entry)
+    assert install.env_for(built.package.name, base_env={"PATH": ""})["PATH"] == str(built.entry)
+    assert not (built.payload / "tools/facts.json").exists()
+    assert Lockfile(built.lock_path).artifacts(built.package.name, built.target) == []
+
+
+@pytest.mark.parametrize("damage", [
+    "catalog-bytes", "binary-bytes", "source-bytes", "source-identity",
+    "binary-digest", "tree-digest", "target", "version", "entry-path", "binary-path",
+    "duplicate", "extra-file", "descriptor-path", "descriptor-hash",
+])
+def test_corruption_fails_before_a_driver_can_be_selected(built, damage):
+    row = built.staged["tool"]
+    if damage == "catalog-bytes":
+        with (built.payload / bundled_tools.CATALOG_NAME).open("ab") as stream:
+            stream.write(b" ")
+    elif damage == "binary-bytes":
+        with (built.entry / row["binary"]).open("ab") as stream:
+            stream.write(b"corruption")
+    elif damage == "source-bytes":
+        (built.entry / bundled_tools.SOURCE_NAME).write_bytes(b"wrong source")
+    elif damage == "extra-file":
+        (built.entry / "unexpected.dll").write_bytes(b"unexpected")
+    elif damage.startswith("descriptor-"):
+        p = built.payload / "manifest.json"
+        manifest = json.loads(p.read_bytes())
+        manifest["bundled_tools"]["path" if damage.endswith("path") else "sha256"] = (
+            "../untrusted.json" if damage.endswith("path") else "0" * 64)
+        p.write_text(json.dumps(manifest), encoding="utf-8")
+    else:
+        def change(document):
+            selected = document["tools"][0]
+            if damage == "duplicate":
+                document["tools"].append(dict(selected))
+                return
+            key, value = {
+                "source-identity": ("source_receipt_sha256", "0" * 64),
+                "binary-digest": ("binary_sha256", "0" * 64),
+                "tree-digest": ("tree_sha256", "0" * 64),
+                "target": ("target", "unsupported-target"),
+                "version": ("version", "9.9.9"),
+                "entry-path": ("entry", "../outside"),
+                "binary-path": ("binary", "../outside"),
+            }[damage]
+            selected[key] = value
+        rewrite_catalog(built, change)
+    with pytest.raises(InstallError, match="invalid sealed source-built tool"):
+        bundled_tools.selected_tool(built.package.name)
+
+
+@pytest.mark.parametrize("link_kind", ["catalog", "source", "entry"])
+def test_symlinked_identity_or_entry_is_not_admitted(built, tmp_path, link_kind):
+    path = {"catalog": built.payload / bundled_tools.CATALOG_NAME,
+            "source": built.entry / bundled_tools.SOURCE_NAME,
+            "entry": built.entry}[link_kind]
+    saved = tmp_path / ("outside-" + path.name)
+    path.rename(saved)
+    try:
+        path.symlink_to(saved, target_is_directory=saved.is_dir())
+    except OSError as exc:
+        saved.rename(path)
+        pytest.skip(f"host cannot create test symlink: {exc}")
+    with pytest.raises(InstallError, match="links"):
+        bundled_tools.selected_tool(built.package.name)
+
+
+@pytest.mark.parametrize("remove_executing_catalog", [False, True])
+def test_environment_overrides_cannot_supply_baked_tool_authority(built, tmp_path, monkeypatch, remove_executing_catalog):
+    decoy = tmp_path / "decoy"
+    shutil.copytree(built.payload, decoy)
+    monkeypatch.setenv("HERMES_RUNTIME_DIR", str(decoy / "tools"))
+    monkeypatch.setenv("HERMES_INSTALL_ROOT", str(decoy / "app"))
+    if remove_executing_catalog:
+        (built.payload / bundled_tools.CATALOG_NAME).unlink()
+        with pytest.raises(InstallError):
+            bundled_tools.selected_tool(built.package.name)
+    else:
+        assert bundled_tools.selected_tool(built.package.name).path == built.entry
+
+
+def test_unsupported_target_and_changed_lock_cannot_reuse_a_native_tool(built):
+    assert bundled_tools.selected_tool(built.package.name, target="unsupported-target") is None
+    lock = json.loads(built.lock_path.read_bytes())
+    lock["packages"][built.package.name]["version"] = "2.0.0"
+    built.lock_path.write_text(json.dumps(lock), encoding="utf-8")
+    with pytest.raises(InstallError, match="locked version"):
+        bundled_tools.selected_tool(built.package.name)
+
+
+def test_unpinned_legacy_fact_cannot_replace_a_missing_source_descriptor(built):
+    import importlib
+    install = importlib.import_module("pm.install")
+    (built.payload / "manifest.json").write_text(json.dumps({
+        "schema": 1, "target": built.target, "repo": "app", "venv": "venv",
+        "store": "tools", "runtime": {"commands": {"hermes": "bin/hermes"}},
+    }), encoding="utf-8")
+    Facts(built.payload / "tools/facts.json").record(
+        built.package.name, "1.0.0", built.entry.name, built.package.env(built.entry, built.target),
+        built.payload / "tools", target=built.target, digest=tree_digest(built.entry))
+    assert install.installed_package(built.package.name) is None
+    assert not install.is_installed(built.package.name)
+
+
+def test_ordinary_remote_artifact_identity_is_unchanged(built, monkeypatch):
+    import importlib
+    install = importlib.import_module("pm.install")
+
+    class RemoteTool(Package):
+        name = "ordinary-remote-tool"
+
+        def binary(self, entry, target):
+            return entry / ("tool.exe" if target.startswith("win32") else "tool")
+
+        def env(self, entry, target):
+            return {"PATH": [str(entry)]}
+
+    package = RemoteTool()
+    monkeypatch.setitem(registry._packages, package.name, package)
+    lock = json.loads(built.lock_path.read_bytes())
+    lock["packages"][package.name] = {"version": "2.0.0", "artifacts": {
+        built.target: {"url": "https://example.invalid/fixture.zip", "sha256": "1" * 64},
+    }}
+    built.lock_path.write_text(json.dumps(lock), encoding="utf-8")
+    entry = built.payload / "tools" / package.store_entry("2.0.0", built.target)
+    entry.mkdir()
+    binary = package.binary(entry, built.target)
+    shutil.copyfile(Path(sys.executable).resolve(), binary)
+    binary.chmod(0o755)
+    Facts(built.payload / "tools/facts.json").record(
+        package.name, "2.0.0", entry.name, package.env(entry, built.target),
+        built.payload / "tools", target=built.target, artifacts=["1" * 64], digest=tree_digest(entry))
+    (built.payload / bundled_tools.CATALOG_NAME).write_bytes(b"corrupt unrelated source catalog")
+    selected = install.installed_package(package.name)
+    assert selected.binary == binary
+    assert install.is_installed(package.name)
+    monkeypatch.setattr(install, "_install", lambda *a, **kw: pytest.fail("unexpected download"))
+    assert install.ensure(package.name, explicit=True).env["PATH"].split(__import__("os").pathsep)[0] == str(entry)
