+"""Scroll targeting follows the live driver schema without guessing its version.
+
+The native Termux integration exposed a driver whose scroll schema accepts x/y
+but has no input.scroll.coordinates token; dropping x/y moved input to center.
+"""
+from types import SimpleNamespace
+from unittest.mock import AsyncMock, Mock
+import asyncio
+
+import pytest
+
+from tools.computer_use.cua_backend import CuaDriverBackend
+
+
+def backend_with_scroll_schema(capabilities, properties):
+    backend = CuaDriverBackend()
+    backend._active_pid = 111
+    backend._active_window_id = 222
+    tool = SimpleNamespace(
+        name="scroll", capabilities=capabilities,
+        inputSchema={"type": "object", "properties": properties, "additionalProperties": False},
+    )
+    client = SimpleNamespace(list_tools=AsyncMock(return_value=SimpleNamespace(tools=[tool])))
+    asyncio.run(backend._session._populate_capabilities(client))
+    backend._session.call_tool = Mock(return_value={
+        "data": "ok", "images": [], "structuredContent": None, "isError": False,
+    })
+    return backend
+
+
+@pytest.mark.parametrize("capabilities,properties,include_coordinates", [
+    ([], {"x": {"type": "number"}, "y": {"type": "number"}}, True),
+    (["input.scroll.coordinates"], {}, True),
+    ([], {"x": {"type": "number"}}, False),
+    ([], {"y": {"type": "number"}}, False),
+    ([], {}, False),
+])
+def test_scroll_preserves_only_advertised_coordinate_support(capabilities, properties, include_coordinates):
+    backend = backend_with_scroll_schema(capabilities, properties)
+
+    result = backend.scroll(direction="down", amount=2, x=80, y=60)
+
+    assert result.ok
+    expected = {"pid": 111, "window_id": 222, "direction": "down", "amount": 2,
+                "session": backend._session_id}
+    if include_coordinates:
+        expected.update(x=80, y=60)
+    backend._session.call_tool.assert_called_once_with("scroll", expected)
+
+
+@pytest.mark.parametrize("window_id,element", [(222, 7), (None, None)])
+def test_scroll_retains_element_precedence_and_exact_window_requirement(window_id, element):
+    backend = backend_with_scroll_schema([], {"x": {"type": "number"}, "y": {"type": "number"}})
+    backend._active_window_id = window_id
+
+    result = backend.scroll(direction="down", amount=2, element=element, x=80, y=60)
+
+    if window_id is None:
+        assert not result.ok
+        backend._session.call_tool.assert_not_called()
+    else:
+        assert result.ok
+        backend._session.call_tool.assert_called_once_with("scroll", {
+            "pid": 111, "window_id": 222, "direction": "down", "amount": 2,
+            "element_index": 7, "session": backend._session_id,
+        })
