+"""Behavioral approval and placement policy for local Termux X11.
+
+Host facts are explicit data at the policy seam. These tests run real shared
+approval/lease gates on the host; native X11 delivery is proved by the probe.
+"""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from tools.bot_desktop import placement
+from tools.computer_use.cua_backend_platform import termux_x11_context
+
+
+@pytest.mark.parametrize(
+    "termux,where,backend,ambient,published,expected",
+    [
+        (True, placement.GATEWAY, "cua", {"DISPLAY": ":73"}, {}, True),
+        (True, placement.GATEWAY, "cua", {}, {"DISPLAY": ":74"}, True),
+        (True, placement.GATEWAY, "cua",
+         {"DISPLAY": ":99", "WAYLAND_DISPLAY": "stale", "XDG_SESSION_TYPE": "wayland"},
+         {"DISPLAY": ":74"}, True),
+        (True, placement.GATEWAY, "cua", {}, {}, False),
+        (True, placement.GATEWAY, "cua",
+         {"DISPLAY": ":73", "WAYLAND_DISPLAY": "wayland-0"}, {}, False),
+        (True, placement.GATEWAY, "cua",
+         {"DISPLAY": ":73", "XDG_SESSION_TYPE": "wayland"}, {}, False),
+        (False, placement.GATEWAY, "cua", {"DISPLAY": ":73"}, {}, False),
+        (True, placement.TERMINAL, "cua", {"DISPLAY": ":73"}, {"DISPLAY": ":74"}, False),
+        (True, placement.REFUSED, "cua", {"DISPLAY": ":73"}, {}, False),
+        (True, placement.GATEWAY, "other-provider", {"DISPLAY": ":73"}, {}, False),
+    ],
+)
+def test_policy_uses_exact_host_placement_provider_and_x11(
+    termux, where, backend, ambient, published, expected,
+):
+    assert termux_x11_context(
+        termux=termux, where=where, backend=backend,
+        ambient=ambient, published=published,
+    ) is expected
+
+
+@pytest.fixture
+def policy_session(tmp_path, monkeypatch):
+    from tools import approval
+    from tools.approval_context import reset_current_session_key, set_current_session_key
+    from tools.computer_use import cua_backend_platform, tool
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "profile"))
+    monkeypatch.setenv("HERMES_INTERACTIVE", "1")
+    key = "termux-policy-" + tmp_path.name
+    token = set_current_session_key(key)
+    tool.reset_backend_for_tests()
+    backend, created, prompts = tool._NoopBackend(), [], []
+
+    def factory(mode):
+        created.append(mode)
+        return backend
+
+    def once(command, description, **kwargs):
+        prompts.append((command, description))
+        return "once"
+
+    monkeypatch.setattr(tool, "_new_backend", factory)
+    monkeypatch.setattr(cua_backend_platform, "local_termux_x11", lambda: True)
+    tool.set_approval_callback(once)
+    yield SimpleNamespace(tool=tool, backend=backend, created=created,
+                          prompts=prompts, key=key, once=once)
+    tool.set_approval_callback(None)
+    tool.reset_backend_for_tests()
+    approval.clear_session(key)
+    reset_current_session_key(token)
+
+
+@pytest.mark.parametrize("mode", [None, "foreground"])
+@pytest.mark.parametrize("action_args", [
+    {"action": "click", "coordinate": [80, 60]},
+    {"action": "scroll", "coordinate": [80, 60], "direction": "down", "amount": 2},
+    {"action": "type", "text": "owned fixture input"},
+])
+def test_default_and_explicit_foreground_are_approved_before_dispatch(
+    policy_session, action_args, mode,
+):
+    state = policy_session
+    args = dict(action_args)
+    if mode is not None:
+        args["delivery_mode"] = mode
+    original = dict(args)
+    result = json.loads(state.tool.handle_computer_use(args, session_id=state.key))
+    assert "error" not in result
+    assert args == original
+    assert len(state.prompts) == 1
+    assert "FOREGROUND" in state.prompts[0][0]
+    assert state.created == ["standard"]
+    assert state.backend.calls[-1][1]["delivery_mode"] == "foreground"
+    assert state.backend.calls[-1][1]["bring_to_front"] is False
+
+
+def test_default_once_does_not_leave_a_reusable_grant(policy_session):
+    from tools import approval
+
+    state = policy_session
+    args = {"action": "click", "coordinate": [80, 60]}
+    for _ in range(2):
+        assert "error" not in json.loads(
+            state.tool.handle_computer_use(args, session_id=state.key),
+        )
+    assert len(state.prompts) == 2
+    assert not approval.is_approved(state.key, "cua:click:foreground")
+
+
+def test_background_session_grant_cannot_approve_default_foreground(policy_session):
+    from tools import approval
+
+    state = policy_session
+
+    def session(command, description, **kwargs):
+        state.prompts.append((command, description))
+        return "session"
+
+    state.tool.set_approval_callback(session)
+    assert state.tool._request_approval("click", {}) is None
+    assert approval.is_approved(state.key, "cua:click:background")
