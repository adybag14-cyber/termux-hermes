diff --git a/pm/bundled_tools.py b/pm/bundled_tools.py
new file mode 100644
index 00000000..de3cee9a
--- /dev/null
+++ b/pm/bundled_tools.py
@@ -0,0 +1,230 @@
+"""Exact source-built tools owned by the executing sealed payload.
+
+These descriptors are separate from downloadable PM artifacts. No URL is
+invented for a native build, and an environment override cannot select one.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import re
+import shutil
+
+from pm.package import InstallError, Package
+
+CATALOG_NAME = "bundled-tools.json"
+SOURCE_NAME = "source-receipt.json"
+_REMEDY = "reinstall or rebuild the complete signed Termux package"
+_ROW_KEYS = {
+    "name", "version", "target", "entry", "binary", "binary_sha256",
+    "source_receipt", "source_receipt_sha256", "tree_sha256",
+}
+
+
+@dataclass(frozen=True)
+class SourceBuiltTool:
+    name: str
+    version: str
+    target: str
+    path: Path
+    binary: Path
+    environment: dict
+
+
+def _sha(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def _digest(value: object) -> bool:
+    return isinstance(value, str) and re.fullmatch(r"[a-f0-9]{64}", value) is not None
+
+
+def _path(payload: Path, relative: str) -> Path:
+    from pm.filesystem import is_junction
+
+    parts = PurePosixPath(relative)
+    if (not relative or parts.is_absolute() or "\\" in relative or ":" in relative
+            or any(part in ("", ".", "..") for part in relative.split("/"))):
+        raise ValueError("invalid source-built tool path")
+    path = payload
+    for part in parts.parts:
+        path = path / part
+        if path.is_symlink() or is_junction(path):
+            raise ValueError("source-built tool paths must not contain links")
+    if not path.resolve().is_relative_to(payload):
+        raise ValueError("source-built tool path escapes payload")
+    return path
+
+
+def _pin(package: Package, target: str, version: str) -> dict:
+    pin = getattr(package, "source_built_receipts", {}).get(target)
+    if (not isinstance(pin, dict) or set(pin) != {"version", "sha256"}
+            or pin["version"] != version or not _digest(pin["sha256"])):
+        raise ValueError("source-built tool has no reviewed source pin for this version and target")
+    return pin
+
+
+def _validate(payload: Path, row: dict, target: str, lock) -> SourceBuiltTool:
+    from pm.registry import get_package
+    from pm.store import tree_digest
+
+    if not isinstance(row, dict) or set(row) != _ROW_KEYS:
+        raise ValueError("malformed source-built tool row")
+    if not all(isinstance(row[key], str) and row[key] for key in _ROW_KEYS):
+        raise ValueError("malformed source-built tool identity")
+    package = get_package(row["name"])
+    version = lock.version(package.name)
+    if row["target"] != target or row["version"] != version:
+        raise ValueError("source-built tool target or locked version mismatch")
+    pin = _pin(package, target, version)
+    if row["source_receipt_sha256"] != pin["sha256"]:
+        raise ValueError("source-built tool source identity mismatch")
+    if not all(_digest(row[key]) for key in ("binary_sha256", "tree_sha256")):
+        raise ValueError("malformed source-built tool digest")
+    expected_entry = "tools/" + package.store_entry(version, target)
+    if row["entry"] != expected_entry or row["source_receipt"] != SOURCE_NAME:
+        raise ValueError("source-built tool entry is not canonical")
+    entry = _path(payload, row["entry"])
+    binary = _path(payload, row["entry"] + "/" + row["binary"])
+    source = _path(payload, row["entry"] + "/" + SOURCE_NAME)
+    if package.binary(entry, target) != binary:
+        raise ValueError("source-built tool binary is not the package executable")
+    if not entry.is_dir() or not binary.is_file() or not source.is_file():
+        raise ValueError("source-built tool files are missing")
+    if set(p.name for p in entry.iterdir()) != {row["binary"], SOURCE_NAME}:
+        raise ValueError("unexpected source-built tool entry contents")
+    if _sha(source) != pin["sha256"]:
+        raise ValueError("source-built tool source receipt was changed")
+    if _sha(binary) != row["binary_sha256"] or tree_digest(entry) != row["tree_sha256"]:
+        raise ValueError("source-built tool bytes were changed")
+    # Byte/architecture validation only: passive selection must not execute a tool.
+    reason = Package.verify(package, entry, target)
+    if reason:
+        raise ValueError("source-built tool binary is incompatible: " + reason)
+    if os.name != "nt" and not os.access(binary, os.X_OK):
+        raise ValueError("source-built tool executable bit is missing")
+    return SourceBuiltTool(package.name, version, target, entry, binary, package.env(entry, target))
+
+
+def _read(payload: Path, manifest: dict, target: str, lock) -> dict[str, SourceBuiltTool]:
+    if manifest.get("target") != target:
+        raise ValueError("source-built tool payload target mismatch")
+    descriptor = manifest["bundled_tools"]
+    if (not isinstance(descriptor, dict) or set(descriptor) != {"path", "sha256"}
+            or descriptor["path"] != CATALOG_NAME or not _digest(descriptor["sha256"])):
+        raise ValueError("malformed source-built tool descriptor")
+    catalog = _path(payload, CATALOG_NAME)
+    if not catalog.is_file() or catalog.stat().st_size > 65536:
+        raise ValueError("source-built tool catalog is missing or too large")
+    if _sha(catalog) != descriptor["sha256"]:
+        raise ValueError("source-built tool catalog SHA-256 mismatch")
+    document = json.loads(catalog.read_bytes())
+    if (not isinstance(document, dict) or set(document) != {"schema_version", "tools"}
+            or type(document["schema_version"]) is not int or document["schema_version"] != 1
+            or not isinstance(document["tools"], list) or not document["tools"]):
+        raise ValueError("malformed source-built tool catalog")
+    tools = {}
+    for row in document["tools"]:
+        tool = _validate(payload, row, target, lock)
+        if tool.name in tools:
+            raise ValueError("duplicate source-built tool")
+        tools[tool.name] = tool
+    return tools
+
+
+def selected_tool(name: str, *, target: str | None = None) -> SourceBuiltTool | None:
+    """Select only a reviewed tool in the executing PM tree's sealed payload."""
+    from pm.environments import _payload_manifest
+    from pm.lock import Lockfile
+    from pm.paths import repo_root
+    from pm.registry import get_package
+    from pm.store import current_target
+
+    target = target or current_target()
+    package = get_package(name)
+    # Ordinary downloadable tools never depend on this optional catalog.
+    if target not in getattr(package, "source_built_receipts", {}):
+        return None
+    root = repo_root().resolve()
+    manifest = _payload_manifest(root)
+    if not manifest or "bundled_tools" not in manifest:
+        return None
+    try:
+        tools = _read(root.parent, manifest, target, Lockfile(root / "pm/lock.json"))
+        return tools.get(name)
+    except (OSError, ValueError, TypeError, KeyError) as exc:
+        raise InstallError(name, f"invalid sealed source-built tool: {exc}", _REMEDY) from exc
+
+
+def stage_source_built_tool(
+    payload: Path, *, name: str, target: str, binary: Path,
+    binary_sha256: str, source_receipt: Path,
+) -> dict:
+    """Publish one verified native build into a completed build-owned payload.
+
+    Call after all binary mutations. This writes its own catalog/manifest
+    descriptor; it does not impersonate remote artifacts in tools/facts.json.
+    """
+    from pm.environments import _payload_manifest
+    from pm.filesystem import durable_write_bytes
+    from pm.lock import Lockfile
+    from pm.registry import get_package
+    from pm.store import tree_digest
+
+    payload = payload.resolve()
+    manifest_path = _path(payload, "manifest.json")
+    manifest = json.loads(manifest_path.read_bytes())
+    repo = _path(payload, manifest["repo"])
+    if _payload_manifest(repo) != manifest or manifest.get("target") != target:
+        raise ValueError("source-built tools require a valid assembled target payload")
+    if "bundled_tools" in manifest or (payload / CATALOG_NAME).exists():
+        raise FileExistsError("source-built tool catalog already exists")
+    package = get_package(name)
+    lock = Lockfile(repo / "pm/lock.json")
+    version = lock.version(name)
+    pin = _pin(package, target, version)
+    if (not _digest(binary_sha256) or binary.is_symlink() or not binary.is_file()
+            or _sha(binary) != binary_sha256):
+        raise ValueError("native build binary SHA-256 mismatch")
+    if (source_receipt.is_symlink() or not source_receipt.is_file()
+            or source_receipt.stat().st_size > 65536 or _sha(source_receipt) != pin["sha256"]):
+        raise ValueError("native build source receipt does not match the reviewed recipe")
+    entry_rel = "tools/" + package.store_entry(version, target)
+    entry = _path(payload, entry_rel)
+    if entry.exists():
+        raise FileExistsError(entry)
+    executable = package.binary(entry, target)
+    if executable is None or executable.parent != entry or executable.name == SOURCE_NAME:
+        raise ValueError("source-built tool must declare one direct executable")
+    entry.mkdir(parents=True)
+    try:
+        shutil.copyfile(binary, executable)
+        executable.chmod(0o755)
+        shutil.copyfile(source_receipt, entry / SOURCE_NAME)
+        (entry / SOURCE_NAME).chmod(0o644)
+        row = {
+            "name": name, "version": version, "target": target,
+            "entry": entry_rel, "binary": executable.name,
+            "binary_sha256": binary_sha256, "source_receipt": SOURCE_NAME,
+            "source_receipt_sha256": pin["sha256"], "tree_sha256": tree_digest(entry),
+        }
+        _validate(payload, row, target, lock)
+        data = (json.dumps({"schema_version": 1, "tools": [row]}, indent=2, sort_keys=True) + "\n").encode()
+        descriptor = {"path": CATALOG_NAME, "sha256": hashlib.sha256(data).hexdigest()}
+        catalog = payload / CATALOG_NAME
+        durable_write_bytes(catalog, data)
+        catalog.chmod(0o644)
+        manifest["bundled_tools"] = descriptor
+        durable_write_bytes(manifest_path, (json.dumps(manifest, indent=2) + "\n").encode())
+        manifest_path.chmod(0o644)
+        return {"descriptor": descriptor, "tool": row}
+    except BaseException:
+        shutil.rmtree(entry)
+        raise
