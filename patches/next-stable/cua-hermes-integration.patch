--- /dev/null
+++ b/tools/computer_use/cua_backend_platform.py
@@ -0,0 +1,84 @@
+"""Local CUA admission and input policy for the reviewed Termux X11 driver.
+
+A sealed PM source build or an explicit executable selects the existing X11
+transport. Startup still validates its full runtime manifest and desktop.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from collections.abc import Mapping
+from typing import Optional
+
+from hermes_platform.host.runtime import is_termux
+
+TERMUX_X11_HINT = (
+    "Termux X11 requires the native cua-driver sealed into this Hermes package, "
+    "or an externally built driver selected by HERMES_CUA_DRIVER_CMD. "
+    "No Android driver download is published by Hermes PM. This driver controls "
+    "X11 desktop windows; Android phone UI is unavailable."
+)
+
+
+def local_cua_supported(platform: str, *, termux: bool, driver_selected: bool) -> bool:
+    """Platform facts are data; Termux requires a reviewed PM or explicit executable."""
+    if termux:
+        return platform in ("android", "linux") and driver_selected
+    return platform in ("darwin", "win32", "linux")
+
+
+def configured_external_driver(override: Optional[str] = None) -> Optional[str]:
+    """Resolve an explicit executable without consulting or acquiring a PM package."""
+    from tools.computer_use.cua_backend_driver import _CUA_DRIVER_CMD_ENV, resolve_cua_driver_cmd
+
+    configured = (override if override is not None else os.environ.get(_CUA_DRIVER_CMD_ENV, "")).strip()
+    return resolve_cua_driver_cmd(configured) if configured else None
+
+
+def local_cua_host_supported(*, override: Optional[str] = None) -> bool:
+    """Admit the selected host driver; manifest/display checks remain at startup."""
+    from tools.computer_use.cua_backend_driver import resolve_cua_driver_cmd
+
+    termux = is_termux()
+    return local_cua_supported(
+        sys.platform, termux=termux,
+        driver_selected=bool(resolve_cua_driver_cmd(override)) if termux else False,
+    )
+
+
+def termux_x11_context(*, termux: bool, where: str, backend: str,
+                      ambient: Mapping[str, str], published: Mapping[str, str]) -> bool:
+    """Input policy from explicit host/placement facts, without acquiring any driver."""
+    from tools.bot_desktop import placement
+
+    if not termux or where != placement.GATEWAY or backend != "cua":
+        return False
+    # A live profile desktop is X11 and overrides stale inherited Wayland variables,
+    # just as runtime.desktop_env does when it spawns the real driver.
+    if published.get("DISPLAY"):
+        return True
+    return bool(ambient.get("DISPLAY") and not ambient.get("WAYLAND_DISPLAY")
+                and ambient.get("XDG_SESSION_TYPE") != "wayland")
+
+
+def local_termux_x11() -> bool:
+    """Whether this call uses the local Termux X11 CUA input/overlay policy."""
+    if not is_termux():
+        return False
+    from plugins.computer_use import configured_backend_name
+    from tools.bot_desktop import placement, runtime
+
+    where = placement.resolve().where
+    if where != placement.GATEWAY:
+        return False  # Never inspect or normalize a remotely placed driver's input.
+    return termux_x11_context(
+        termux=True, where=where, backend=configured_backend_name(),
+        ambient=os.environ, published=runtime.published_env(),
+    )
+
+
+def local_cua_unsupported_reason() -> str:
+    if is_termux() or sys.platform == "android":
+        return TERMUX_X11_HINT
+    return f"Local cua-driver is not supported on this host platform ({sys.platform})."
