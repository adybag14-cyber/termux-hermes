@@ -0,0 +1,49 @@
+"""Local CUA admission for an externally owned Termux X11 driver.
+
+PM does not publish a Bionic driver. An explicit executable only enables the
+existing X11 transport; startup still validates its full runtime manifest.
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from typing import Optional
+
+from hermes_platform.host.runtime import is_termux
+
+TERMUX_X11_HINT = (
+    "Termux X11 requires an externally built native cua-driver selected by "
+    "HERMES_CUA_DRIVER_CMD. No Android driver is published by Hermes PM. "
+    "This experiment controls X11 desktop windows; Android phone UI is unavailable."
+)
+
+
+def local_cua_supported(platform: str, *, termux: bool, explicit_driver: bool) -> bool:
+    """Platform facts are data; Termux always requires an explicit external executable."""
+    if termux:
+        return platform in ("android", "linux") and explicit_driver
+    return platform in ("darwin", "win32", "linux")
+
+
+def configured_external_driver(override: Optional[str] = None) -> Optional[str]:
+    """Resolve an explicit executable without consulting or acquiring a PM package."""
+    from tools.computer_use.cua_backend_driver import _CUA_DRIVER_CMD_ENV, resolve_cua_driver_cmd
+
+    configured = (override if override is not None else os.environ.get(_CUA_DRIVER_CMD_ENV, "")).strip()
+    return resolve_cua_driver_cmd(configured) if configured else None
+
+
+def local_cua_host_supported(*, override: Optional[str] = None) -> bool:
+    """Cheap host admission; manifest and display checks remain at startup/readiness."""
+    termux = is_termux()
+    return local_cua_supported(
+        sys.platform, termux=termux,
+        explicit_driver=bool(configured_external_driver(override)) if termux else False,
+    )
+
+
+def local_cua_unsupported_reason() -> str:
+    if is_termux() or sys.platform == "android":
+        return TERMUX_X11_HINT
+    return f"Local cua-driver is not supported on this host platform ({sys.platform})."
