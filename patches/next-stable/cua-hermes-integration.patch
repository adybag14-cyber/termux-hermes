new file mode 100644
index 00000000..b04e6ba4
--- /dev/null
+++ b/tests/tools/test_computer_use_termux_override.py
@@ -0,0 +1,138 @@
+"""External Termux X11 admission never implies a bundled driver or phone UI support."""
+
+import json
+import sys
+
+import pytest
+
+from plugins.computer_use.cua import _available_for_placement
+from tools.bot_desktop import placement
+
+
+@pytest.mark.parametrize("platform", ["android", "linux"])
+def test_termux_requires_the_explicit_external_driver(platform):
+    def absent():
+        return False
+
+    assert _available_for_placement(
+        platform, placement.GATEWAY, lambda: True,
+        termux=True, explicit_driver=True,
+    )
+    assert not _available_for_placement(
+        platform, placement.GATEWAY, lambda: True,
+        termux=True, explicit_driver=False,
+    )
+    assert not _available_for_placement(
+        platform, placement.GATEWAY, absent,
+        termux=True, explicit_driver=True,
+    )
+
+
+@pytest.mark.parametrize("where", [placement.GATEWAY, placement.REFUSED])
+def test_external_binary_does_not_admit_an_android_phone_host(where):
+    assert not _available_for_placement(
+        "android", where, lambda: True, termux=False, explicit_driver=True,
+    )
+
+
+def test_remote_placement_never_resolves_the_local_external_driver():
+    def forbidden():
+        pytest.fail("a remotely placed driver must remain inside its selected terminal backend")
+
+    assert _available_for_placement(
+        "android", placement.TERMINAL, forbidden,
+        termux=True, explicit_driver=False,
+    )
+    assert not _available_for_placement(
+        "android", placement.REFUSED, forbidden,
+        termux=True, explicit_driver=True,
+    )
+
+
+def test_external_lookup_uses_only_the_exact_override(tmp_path, monkeypatch):
+    import pm
+    from tools.computer_use.cua_backend_platform import configured_external_driver
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("external selection must not fall through to PM")
+
+    monkeypatch.setattr(pm, "installed_package", forbidden)
+    monkeypatch.setattr(pm, "ensure", forbidden)
+    monkeypatch.delenv("HERMES_CUA_DRIVER_CMD", raising=False)
+    assert configured_external_driver() is None
+    monkeypatch.setenv("HERMES_CUA_DRIVER_CMD", sys.executable)
+    assert configured_external_driver() == sys.executable
+    assert configured_external_driver(str(tmp_path / "missing-driver")) is None
+    assert configured_external_driver(sys.executable + " mcp --direct") is None
+    assert configured_external_driver("") is None
+
+
+def test_registered_handler_rejects_unusable_external_manifest(monkeypatch):
+    """A real host executable passes passive lookup but cannot bypass runtime validation."""
+    import pm
+    import tools.computer_use_tool
+    from tools.computer_use.tool import release_computer_use_session
+    from tools.registry import registry
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("an explicit driver must not trigger PM acquisition or SDK setup")
+
+    monkeypatch.setenv("HERMES_CUA_DRIVER_CMD", sys.executable)
+    monkeypatch.setattr(pm, "ensure", forbidden)
+    monkeypatch.setattr(pm, "ensure_import", forbidden)
+    session_id = "external-driver-invalid-manifest"
+    try:
+        assert registry.is_toolset_available("computer_use")
+        result = json.loads(registry.dispatch(
+            "computer_use", {"action": "list_windows"}, session_id=session_id,
+        ))
+        assert "error" in result
+        assert "not ready" in result["error"]
+        assert "HERMES_CUA_DRIVER_CMD" in result["error"]
+    finally:
+        release_computer_use_session(session_id)
+
+
+@pytest.mark.parametrize("ambient_display", [None, ":999"])
+def test_readiness_process_uses_the_published_desktop(tmp_path, monkeypatch, ambient_display):
+    """Real child env from product files; the fixture does not claim to run an X server."""
+    import os
+
+    import psutil
+
+    from tools.bot_desktop import runtime
+    from tools.computer_use import permissions
+
+    home = tmp_path / "owned-profile"
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    state = runtime.state_dir()
+    state.mkdir(parents=True)
+    owner = psutil.Process()
+    (state / "launcher.pid").write_text(
+        f"{owner.pid} {owner.create_time()}\n", encoding="utf-8",
+    )
+    published = {
+        "DISPLAY": ":73",
+        "XAUTHORITY": str(state / "Xauthority"),
+        "DBUS_SESSION_BUS_ADDRESS": "unix:path=owned-desktop-bus",
+    }
+    (state / "env").write_text(
+        "".join(f"{key}={value}\n" for key, value in published.items()), encoding="utf-8",
+    )
+    if ambient_display is None:
+        monkeypatch.delenv("DISPLAY", raising=False)
+    else:
+        monkeypatch.setenv("DISPLAY", ambient_display)
+    monkeypatch.setenv("XAUTHORITY", "stale-parent-authority")
+    monkeypatch.setenv("DBUS_SESSION_BUS_ADDRESS", "unix:path=stale-parent-bus")
+    monkeypatch.setenv("ANTHROPIC_API_KEY", "fixture-secret-must-not-be-forwarded")
+    keys = [*published, "CUA_DRIVER_RS_TELEMETRY_ENABLED"]
+    program = (
+        "import json,os;"
+        f"print(json.dumps({{k:os.environ.get(k) for k in {keys!r}}}));"
+        "assert 'ANTHROPIC_API_KEY' not in os.environ"
+    )
+    result = permissions._run(sys.executable, "-c", program, timeout=10)
+    assert result.returncode == 0, result.stderr
+    assert json.loads(result.stdout) == {**published, "CUA_DRIVER_RS_TELEMETRY_ENABLED": "0"}
+    assert os.environ.get("DISPLAY") == ambient_display
