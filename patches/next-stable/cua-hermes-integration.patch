@@ -0,0 +1,29 @@
+"""Termux CUA setup guidance limits sealed or explicit drivers to X11."""
+
+from hermes_cli.tools_config_cua import _print_cua_platform_notes
+
+
+def test_termux_guidance_does_not_request_macos_permissions(capsys):
+    _print_cua_platform_notes(False, False, fresh_install=True, is_termux_x11=True)
+    output = capsys.readouterr().out
+    assert "Termux X11" in output
+    assert "HERMES_CUA_DRIVER_CMD" in output
+    assert "Android phone" in output
+    assert "System Settings" not in output
+    assert "CuaDriver.app" not in output
+
+
+def test_computer_use_category_keeps_external_provider_discovery(tmp_path, monkeypatch):
+    from hermes_cli.tools_config import TOOL_CATEGORIES
+    from hermes_cli.tools_config_providers import _PLUGIN_ROW_BUILDERS
+
+    home = tmp_path / "profile"
+    provider = home / "plugins" / "owned-fixture"
+    provider.mkdir(parents=True)
+    (provider / "__init__.py").write_text("# register_computer_use_provider\n", encoding="utf-8")
+    (provider / "plugin.yaml").write_text(
+        "name: owned-fixture\ndescription: An unselected fixture provider\n", encoding="utf-8",
+    )
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    rows = _PLUGIN_ROW_BUILDERS[TOOL_CATEGORIES["computer_use"]["name"]]()
+    assert any(row["computer_use_backend"] == "owned-fixture" for row in rows)
